#!/usr/bin/env python3
"""The grapher's own entry point. timbersh calls the same module in
process, which is what `timberview` does and for the same reason."""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path[:0] = [p for p in (_HERE, "/usr/share/timberfs-sh")
                if os.path.exists(os.path.join(p, "timbergraph.py"))]
from timbergraph import cli            # noqa: E402

if __name__ == "__main__":
    sys.exit(cli())
