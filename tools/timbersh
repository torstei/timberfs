# name is the currency everywhere below — the HOST column, a store's
# `_host`, the host in an address — and only the transport looks up the
# way to reach it behind that.
FLEET = timberfs_client.Fleet(
    [timberfs_client.Target(None, cmd=timberfs_client.DEFAULT_CMD)],
    "the default")
TARGETS = [None]
# How long the store list is reused for completion and `\d`. ZERO is
# never: the list is read once and kept, because a store appearing
# mid-session is rare and paying a round trip for it on a schedule is not.
# `refresh` is the way to ask, which is better than a timer either way —
# it happens when you know something changed, and it says what did.
STORE_TTL = float(os.environ.get("TIMBERSH_STORE_TTL", "0"))
# How much of an answer comes back per CALL, which is not the `limit` in
# the statement: that says how much of the ANSWER you want, this says how
# much of it may be in memory at once. Nothing streams — one call is one
# whole answer buffered, times the hosts asked in parallel — and a 1 GiB
# store on thirteen hosts is not a query, it is an OOM. An unbounded read
# is walked a page at a time and hands the positions back as the next
# page's cursor.
PAGE = int(os.environ.get("TIMBERSH_PAGE", "10000"))
# What a tail opens with, when the statement names no `limit`: the last N
# entries, the way `tail -n` does. The server delivers ABOUT that many —
# it starts at a chunk boundary — so it is trimmed to exactly N here.
BURST = int(os.environ.get("TIMBERSH_TAIL", "20"))
RC = os.environ.get("TIMBERSH_RC", os.path.expanduser("~/.timbershrc"))
HISTFILE = os.environ.get("TIMBERSH_HISTFILE",
                          os.path.expanduser("~/.timbersh-history"))
HISTSIZE = int(os.environ.get("TIMBERSH_HISTSIZE", "2000"))
KINDS = ("records", "loglines", "stores", "chunks")
OPS = ("!=", "!~", "!*", "=~", "=*", "=")

