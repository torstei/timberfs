# ---------------------------------------------------------------- lexing
def lex(s):
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c.isspace():
            i += 1
        elif c == ";":
            out.append((";", ";")); i += 1
        elif c == "[":
            j = s.index("]", i)
            out.append(("pred", s[i + 1 : j])); i = j + 1
        elif c in "'\"":
            j = s.index(c, i + 1)
            out.append(("str", s[i + 1 : j])); i = j + 1
        else:
            j = i
            while j < len(s) and not s[j].isspace() and s[j] not in ";[":
                j += 1
            out.append(("word", s[i:j])); i = j
    return out


# Rust's regex metacharacters. Escaping them is what turns a typed name
# into a LITERAL inside the anchored `=~` match below.
RX_META = "\\.+*?()|[]{}^$"


def rx_literal(text):
    return "".join("\\" + c if c in RX_META else c for c in text)


def parse_pred(text):
    """`type=console,host=web01` -> document terms. The SYNTAX is parsed
    here; what it MEANS is timberfs's business, and asking it is the only
    way to know."""
    terms = []
    for part in [p for p in text.split(",") if p.strip()]:
        for op in OPS:
            if op in part:
                k, v = part.split(op, 1)
                terms.append({"key": k.strip(), "op": op, "value": v.strip()})
                break
        else:
            # Something that LOOKS like an operator but is not one is a
            # typo, not a store called that. Reading it as a name would
            # answer "0 stores" for a search that was never run.
            if any(c in part for c in "=~!*"):
                raise ValueError(
                    f"`{part.strip()}` has no operator I know — one of "
                    + ", ".join(OPS))
            # A bare word is the NAME, matched anywhere in it. Spelled as
            # an escaped anchored regex rather than `=*` for the reason in
            # `backslash`: a timberfs before 0.24.0 truncates `=*` to `=`
            # and reads the `*` as part of the value, silently.
            terms.append({"key": "name", "op": "=~",
                          "value": f".*{rx_literal(part.strip())}.*"})
    return terms


# ------------------------------------------------------------- timberfs
def target_for(host):
    """The target reached under one name. A LOOKUP, not a substitution:
    two hosts may be reached in completely different ways — one over ssh,
    one over a socket — which is why the transport belongs to the target."""
    t = FLEET.by_name(host)
    if t is None:
        raise ValueError(f"no target named {host!r} — `show hosts;` lists them")
    return t


def run(doc, host=None, raw=False):
    """One document to one host. A transport that never started — ssh
    refusing, a wrapper missing, nothing listening on the socket — comes
    back as a non-zero rc with its own words, and is reported rather than
    counted as an empty answer.

    `raw` keeps the answer as BYTES: a `chunks` answer carries compressed
    frames, and decoding those as text destroys them."""
    out, err, rc = target_for(host).run(json.dumps(doc).encode())
    return (out if raw else out.decode("utf-8", "replace")), err, rc


def stream(doc, host, emit, framed=True):
    """One document to one host, read AS IT ARRIVES.

    `emit(record)` is called from this thread for every record — or every
    complete line where the answer is not framed — and returns
    `(stderr, rc)` when the process has finished. The buffering `run`
    above waits for the whole answer first, which on a fleet means the
    fastest host's first line waits for the slowest host's last one.

    ⚠ `read1`, not `read`. A `BufferedReader.read(n)` blocks until it has
    n bytes or EOF, which is the buffering this exists to avoid — and it
    is what a chunked HTTP body gives back a piece at a time too, which
    is why one loop serves a pipe and a socket alike."""
    call = target_for(host).open(json.dumps(doc).encode())
    buf = b""
    while True:
        chunk = call.read1(65536)
        if not chunk:
            break
        buf += chunk
        if framed:
            recs, buf = timberview.frames_from(buf)
            for r in recs:
                emit(r)
        else:
            *lines, buf = buf.split(b"\n")
            for line in lines:
                emit(("line", {}, line))
    # A last line with no newline is still a line.
    if not framed and buf:
        emit(("line", {}, buf))
    return call.finish()


# --------------------------------------------------------------- render
def facets(stores):
    keys, n = {}, len(stores)
    for s in stores:
        for k, v in (s.get("labels") or {}).items():
            keys.setdefault(k, {}).setdefault(str(v), 0); keys[k][str(v)] += 1
    return {k: (vs, n - sum(vs.values())) for k, vs in keys.items()
            if not (len(vs) == 1 and sum(vs.values()) == n)}


def common(stores):
    if not stores: return {}
    f = stores[0].get("labels") or {}
    return {k: v for k, v in f.items()
            if all((s.get("labels") or {}).get(k) == v for s in stores)}


def human(n):
    for u in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or u == "GiB":
            return f"{n:.0f} {u}" if u == "B" else f"{n:.1f} {u}"
        n /= 1024


SHORT_ID = 8


def short_id(s):
    return (s.get("id") or "-")[:SHORT_ID]


def describe_store(s):
    """One store in full, the way `\\d name` describes a relation. Every
    field the answer carries, because the point of asking about ONE is
    that you want what the table view had to leave out."""
    lab = s.get("labels") or {}
    rows = ([("name", s.get("name")), ("id", s.get("id", "(none)"))]
            + ([("host", s["_host"])] if s.get("_host") else [])
            + [
        ("forest", s.get("forest") or "-"),
        ("kind", s.get("kind")),
        ("labels", " ".join(f"{k}={v}" for k, v in sorted(lab.items())) or "(none)"),
        ("chunks", f"{s.get('chunks', 0)}  (seq {s.get('first_seq','-')}..{s.get('last_seq','-')})"),
        ("size", f"{human(s.get('compressed_bytes',0))} compressed"
                 f"  /  {human(s.get('logical_bytes',0))} logical"),
        ("write span", f"{when_ms(s.get('first_write_ms'))}  ..  {when_ms(s.get('last_write_ms'))}"),
    ])
    if s.get("dropped_chunks"):
        rows.append(("dropped", f"{s['dropped_chunks']} chunks, "
                                f"{human(s.get('dropped_uncompressed_bytes',0))} off the tape"))
    rows.append(("index", f"grain over {s['grain_chunks']} chunks" if s.get("grain_chunks")
                 else ("declared, not built yet" if s.get("index_declared") else "none")))
    # A writer is reported only while it LIVES, so its presence is the
    # liveness — there is no separate "is it running" field to disagree.
    rows.append(("writer", s.get("writer") or "none (nothing appending)"))
    rows.append(("wal", "yes (live edge is tailable)" if s.get("wal_declared") else "no"))
    if s.get("followers"):
        rows.append(("followers", ", ".join(f.get("name", "?") for f in s["followers"])))
    rows.append(("path", s.get("path")))
    on = f"  on {s['_host']}" if s.get("_host") else ""
    print(f"\nStore \"{s.get('name')}\"{on}")
    for k, v in rows:
        print(f"  {k:12} {v}")


def fmt_err(why):
    """The WHOLE reason, however many hosts said it.

    This used to keep only the first line when there were several hosts, on
    the theory that a fleet's worth of failures has to stay readable. It
    does — but the first line is not the reason. `visena-timberfs` opens
    with "The query document was refused:" and puts the sentence that
    matters underneath; timberfs puts it in a `Caused by:`. Nine hosts each
    reporting a colon and nothing after it is not readable, it is empty.
    What keeps a fleet readable is saying an identical failure ONCE, which
    is `report_errors`."""
    lines = [x.rstrip() for x in (why or "").strip().splitlines() if x.strip()]
    return "\n     ".join(lines) or "no reason given"


def report_errors(bad):
    """One line per DISTINCT failure, naming who had it.

    A fleet fails the same way at the same time — a document every host
    refuses, a credential that expired — and printing it once per host
    buries the sentence under the list of who said it."""
    if not bad:
        return
    by_msg = {}
    for host, why in bad.items():
        by_msg.setdefault(fmt_err(why), []).append(host)
    for msg, hosts in by_msg.items():
        if len(TARGETS) == 1:
            who = label(hosts[0])
        elif len(hosts) == len(TARGETS):
            who = f"all {len(hosts)} hosts"
        else:
            who = ", ".join(label(h) for h in TARGETS if h in hosts)
        print(f"  ⚠ {who}: {msg}")


def show_unreachable(bad):
    """Named FIRST, not as a footnote: a short list and a broken one look
    the same, and the point of merging hosts is that you stop counting
    them yourself. Grouped like every other failure, so a fleet that went
    down for one reason says it once."""
    if not bad:
        return
    by_msg = {}
    for host, why in bad.items():
        by_msg.setdefault(fmt_err(why), []).append(host)
    for msg, hosts in by_msg.items():
        who = ", ".join(label(h) for h in TARGETS if h in hosts) or ", ".join(
            label(h) for h in hosts)
        print(f"  ⚠ {who}: UNREACHABLE — {msg}")


def show_stores(stores, verbose=False, unreachable=None):
    show_unreachable(unreachable)
    n = len(stores)
    c = common(stores)
    hdr = f"{n} store" + ("" if n == 1 else "s")
    if c: hdr += "   ·   all " + " ".join(f"{k}={v}" for k, v in sorted(c.items()))
    print(hdr)
    f = facets(stores)
    if n <= 25 or not f:
        # The ID column is a PREFIX and is labelled as one, because it is
        # hex either way and `id=` is an exact match: pasting what is shown
        # here selects nothing.
        # The host column appears only when there is more than one, so a
        # single-host session looks exactly as it did.
        multi = len(TARGETS) > 1
        hw = max([len(s.get("_host") or "") for s in stores] + [4]) if multi else 0
        hdr = f"  {'HOST':{hw}}  " if multi else "  "
        hdr += f"{'NAME':30} {'ID(8)':{SHORT_ID}}  {'SIZE':>9}"
        print(hdr + ("      CHUNKS  WRITE SPAN" if verbose else "   LABELS"))
        # No row numbers. A store is named, and its NAME is what every
        # other command takes; an ordinal changes the moment another store
        # appears, which is the same trap as naming one by its path.
        for s in sorted(stores, key=lambda s: (s.get("_host") or "", s["name"])):
            lab = " ".join(f"{k}={v}" for k, v in sorted((s.get("labels") or {}).items())
                           if k not in c)
            row = f"  {s.get('_host') or '':{hw}}  " if multi else "  "
            row += (f"{s['name']:30} {short_id(s):{SHORT_ID}}  "
                    f"{human(s.get('compressed_bytes',0)):>9}")
            if verbose:
                row += (f" {s.get('chunks',0):>7} ch  "
                        f"{when_ms(s.get('first_write_ms'))} .. {when_ms(s.get('last_write_ms'))} ")
            print(f"{row}  {lab}")
    else:
        print("  (too many to list)")
    if f:
        seen, alias = {}, {}
        for k in list(f):
            sig = tuple(sorted(f[k][0].items())) + (f[k][1],)
            if sig in seen: alias.setdefault(seen[sig], []).append(k); del f[k]
            else: seen[sig] = k
        print("  narrow by:")
        for k, (vs, miss) in sorted(f.items(), key=lambda x: -len(x[1][0])):
            top = sorted(vs.items(), key=lambda x: (-x[1], x[0]))
            bits = "  ".join(f"{v}·{c2}" for v, c2 in top[:5])
            if len(top) > 5: bits += f"  +{len(top)-5} more"
            if miss: bits += f"   (no {k}·{miss})"
            if alias.get(k): bits += f"   (= {', '.join(alias[k])})"
            print(f"    {k:16} {bits}")


def records(out):
    """The typed stream. Entries carry which store they came from, which
    is the whole reason to ask for `records` over `loglines`."""
    for rec in out.split("\x1e"):
        if not rec: continue
        head, _, rest = rec.partition("\0")
        parts = head.split("\x1f")
        kind, fields = parts[0], dict(
            p.split("=", 1) for p in parts[1:] if "=" in p)
        payload = rest.split("\0", 1)[0] if kind == "entry" else None
        yield kind, fields, payload


def which(f, ids, known=None):
    """Which store an entry came from.

    An entry names it only where the answer holds several, and a TAIL
    answer carries no `source` record at all — so one store is identified
    by BEING the only one: the answer's single source, or the single store
    the caller already found on this host."""
    if f.get("id"):
        return f["id"]
    if len(ids) == 1:
        return ids[0]
    if known and len(known) == 1:
        return next(iter(known))
    return ""


def show_loglines(out, by_path, header=None, limit=None):
    """timberfs prefixes each line with the store's PATH, which on a fleet
    is most of the terminal and none of the information. Rewrite it to the
    store's name, in the column `records` uses, so the two kinds read the
    same way.

    Split on the FIRST colon and look the prefix up: a path that is not a
    store we know about is left exactly as it came, because guessing at
    the shape of a line is how a log line containing a colon becomes a
    truncated one."""
    n = 0
    for line in out.splitlines():
        if limit is not None and n >= limit:
            break
        if header and n == 0:
            print(header)
        head, sep, rest = line.partition(":")
        if sep and head in by_path:
            print(f"  {by_path[head]:28} {rest}")
        else:
            print(f"  {line}" if line else "")
        n += 1
    return n


def show_records(out, names, header=None, limit=None, note=True):
    last, shown = None, 0
    for kind, f, payload in records(out):
        if kind == "source":
            names[f.get("id", "?")] = os.path.basename(f.get("path", "?"))
        elif kind == "entry":
            if limit is not None and shown >= limit:
                continue
            if header and shown == 0:
                print(header)
            who = names.get(f.get("id", ""), "")
            for i, line in enumerate((payload or "").rstrip("\n").split("\n")):
                print(f"  {who:28} {line}" if i == 0 else f"  {'':28} {line}")
            shown += 1
        elif kind == "stream-end":
            # Only where something was shown: a per-host "0 entries" from
            # every host that had nothing is the noise the header fix is
            # about, said a second way.
            # Not where the CLIENT truncated: the server's count would
            # then describe more than was shown.
            if note and (shown or header is None) and limit is None:
                note = f"  -- {f.get('entries','?')} entries"
                if f.get("status") == "limited":
                    note += f", STOPPED by {f.get('limit','a bound')}"
                print(note)
    return shown


def label(host):
    return host or "(local)"


def unwrap(text):
    """An answer, as (stores, server_version).

    A JSON answer is an object carrying `server_version` beside what was
    asked for. Before that field existed it was the bare array, and that
    is still what the deployed fleet sends — so the SHAPE says which, and
    an older server is one whose version is simply unknown rather than one
    that has to be detected some other way."""
    payload = json.loads(text or "[]")
    if isinstance(payload, dict):
        stores = payload.get("stores")
        if stores is None:
            raise ValueError("an answer object with no `stores`: "
                             + ", ".join(sorted(payload)) or "(empty)")
        return stores, payload.get("server_version")
    if isinstance(payload, list):
        return payload, None
    raise ValueError(f"expected an answer, got {type(payload).__name__}")


# The tape is addressed on the WRITE axis and an investigation window is
# stated on the LOGLINE one, so a chunk written at 14:05 can hold an entry
# stamped 13:00. timberfs widens a logline selection by the same margin
# for the same reason; the bound can then only over-INCLUDE, which is the
# safe direction — a line belonging to the window is never lost, and a few
# that do not may be seen.
WIDEN_MS = 60_000


# ---------------------------------------------------------------- build
def build(kind, terms, conds, limit, session=None, notes=None):
    doc = {"v": "1.0-EXPERIMENTAL", "stores": {"select": terms}}
    win, match = {}, {"all": [], "any": [], "none": []}
    gran = None
    for c in conds:
        t = c["t"]
        if t == "time":
            win["axis"] = c["axis"]
            win[c["end"]] = c["ms"]
        else:
            gran = c["gran"] if gran is None else gran
            if c["gran"] != gran:
                raise ValueError(
                    "a query asks about entries or about chunks, not both — "
                    "`entry has` and `chunk may have` in one where")
            (match["none"] if c["neg"] else match["all"]).append(
                {c["kind"]: c["text"]})
    # What was ASKED for, before any default overwrites it. Checking after
    # the defaults meant `select chunks ... where logline since` had its
    # axis rewritten to `write` and then passed — the timestamp typed
    # against one clock, silently applied to the other.
    asked = win.get("axis")
    if kind in ("records", "loglines") and asked is None:
        win["axis"] = "logline"
    if kind == "chunks":
        win["axis"] = "write"
    # Refused HERE, not by every host in turn. This shell chose both halves
    # — the kind from `select loglines`, the axis from `written since` — so
    # sending a pair it could have known was incoherent is a builder
    # defect, and nine hosts relaying one verdict is not a better error.
    #
    # It is safe to know this where the SELECTOR would not be: getting it
    # wrong can only refuse something the server would have accepted, which
    # is loud. A drifted selector returns different ENTRIES, silently.
    #
    # And it can be said in the words that were typed, which timberfs
    # cannot — it only ever saw `window.axis` and `response_format.kind`.
    if asked == "write" and kind in ("records", "loglines"):
        raise ValueError(
            f"`written since`/`until` selects whole CHUNKS, so it cannot answer "
            f"with {kind} — a chunk has one write window covering everything in "
            f"it.\n     For entries, ask on the clock the lines carry: `logline "
            f"since ...`.\n     For the raw chunks the write axis does give: "
            f"`select chunks from ...`.")
    if asked == "logline" and kind == "chunks":
        raise ValueError(
            "`select chunks` is the write axis — chunks carry no entry parsing, "
            "so a logline window has nothing to apply to.\n     Use `written "
            "since ...`, or ask for `records`/`loglines` instead.")
    if session:
        win = impose_session(win, session, notes)
    if win: doc["window"] = win
    if gran is not None:
        match = {k: v for k, v in match.items() if v}
        match["granularity"] = gran
        doc["match"] = match
    if limit: doc["max"] = limit
    doc["response_format"] = {"kind": kind}
    return doc


def impose_session(win, session, notes=None):
    """The session window, INTERSECTED with what the statement asked for.

    A statement may narrow inside the session and never widen out of it:
    the window is the investigation, and a query that quietly reached
    outside it would be the thing this exists to stop. One that asks for a
    range with no overlap at all is refused rather than answered emptily,
    because an empty answer and a question that could not have one look
    the same.

    ⚠ On the WRITE axis — a `chunks` read, which is the tape — the
    session is applied WIDENED, because the two clocks are not the same
    one. It can then only over-include; see WIDEN_MS."""
    wide = WIDEN_MS if win.get("axis") == "write" else 0
    lo = session.get("from")
    hi = session.get("to")
    out = dict(win)
    if lo is not None:
        out["from"] = max(win["from"], lo - wide) if "from" in win else lo - wide
    if hi is not None:
        out["to"] = min(win["to"], hi + wide) if "to" in win else hi + wide
    if "from" in out and "to" in out and out["from"] > out["to"]:
        raise ValueError(
            f"that window lies outside the session ({show_window(session)}) — "
            f"a statement narrows inside it, never out of it. `drop session;` "
            f"first, or ask for a range within it")
    # ⚠ A statement that reached PAST the session is answered inside it,
    # which is the rail doing its job — and said, because a question
    # quietly answered as a different one is the thing this format
    # refuses everywhere else.
    # Only where an end the STATEMENT named was moved. The session
    # supplying the end a statement left open is the ordinary case and
    # says nothing; being pulled back from one it asked for is the case
    # worth a word.
    moved = any(e in win and out[e] != win[e] for e in ("from", "to"))
    if notes is not None and moved:
        notes.append(f"  -- read inside the session ({show_window(session)}); "
                     f"the window asked for reaches outside it")
    return out


def show_window(session):
    ends = []
    if session.get("from") is not None:
        ends.append("from " + when_ms(session["from"]))
    if session.get("to") is not None:
        ends.append("to " + when_ms(session["to"]))
    return " ".join(ends) or "unbounded"


def parse_where(toks, i):
    """`entry has 'X'` / `chunk may have 'X'` / `logline since 'T'`. The
    SUBJECT carries what the document makes required — granularity and
    axis — so neither can be defaulted by accident."""
    conds = []
    # What ENDS a where clause. Lowercased, so a shouted LIMIT stops it
    # too — and `into`, which names where the answer goes rather than
    # what it contains.
    while i < len(toks) and toks[i][1].lower() not in (";", "limit", "into"):
        w = toks[i][1].lower()
        if w == "and": i += 1; continue
        if w in ("entry", "chunk"):
            gran = "entries" if w == "entry" else "chunks"
            i += 1
            neg = False
            if toks[i][1].lower() == "not": neg = True; i += 1
            if toks[i][1].lower() == "may": i += 1          # `chunk may have`
            verb = toks[i][1].lower(); i += 1
            if verb == "have": verb = "has"
            if verb not in ("has", "substring", "regex"):
                raise ValueError(f"`{verb}`? expected has, substring or regex")
            if toks[i][0] != "str":
                raise ValueError("the text must be quoted")
            conds.append({"t": "p", "gran": gran, "neg": neg,
                          "kind": verb, "text": toks[i][1]}); i += 1
        elif w in ("logline", "written", "write"):
            axis = "logline" if w == "logline" else "write"
            i += 1
            rel = toks[i][1].lower(); i += 1
            if rel in ("since", "after", "from"): ends = [("from", toks[i][1])]; i += 1
            elif rel in ("until", "before", "to"): ends = [("to", toks[i][1])]; i += 1
            elif rel == "between":
                a = toks[i][1]; i += 1
                if toks[i][1].lower() == "and": i += 1
                b = toks[i][1]; i += 1
                ends = [("from", a), ("to", b)]
            else: raise ValueError(f"`{rel}`? expected since, until or between")
            for end, text in ends:
                conds.append({"t": "time", "axis": axis, "end": end,
                              "ms": when(text)})
        else:
            raise ValueError(
                f"`{w}`? a condition starts with entry, chunk, logline or written")
    return conds, i


# ----------------------------------------------------------- completion
BACKSLASH = ["\\d", "\\d+", "\\dv", "\\?", "\\q"]
AFTER_ENTRY = ["has", "not", "substring", "regex"]
AFTER_TIME = ["since", "until", "between"]
SUBJECTS = ["entry", "chunk", "logline", "written"]


# ---------------------------------------------------------------- grammar
#
# THE statement shapes, once. The completer is generated from this and
# knows nothing else, so a statement that is added here is completable and
# one that is not, is not — where the two used to be written separately
# and `create session` arrived in the parser alone.
#
# A `<placeholder>` is a value: `OFFERS` says what may be typed there, and
# an empty answer means "anything, so offer nothing". One ending in `...`
# is a sub-grammar that consumes the rest of the line — a clause list, a
# coordinate, a nested statement — and has a handler below, because those
# repeat or nest and a flat shape cannot say so.
#
# ⚠ The parser in `do()` is still hand-written and this does not drive it
# yet. It is the index of what exists, which is the half that was drifting.
FORMS = """
    select <kind> from <source> <clauses...>
    tail   <kind> from <source> <tailclauses...>
    view   <source> <at...>
    declare <name> cursor for <statement...>
    fetch  <n> from <cursor>
    close  <cursor>
    create logview <name> <pred>
    create logview <pred> <name>
    create session <ends...>
    drop   logview <view>
    drop   host <host>
    drop   session
    show   hosts
    show   logviews
    show   cursors
    show   session
    add    host <newhost>
    refresh
    save   <file>
    load   <file>
    help
    quit
    exit
"""


class Complete:
    """The grammar earns its keep here: at every point exactly one kind of
    thing can come next, so the completer never has to guess. A verb, a
    kind, a view name, a label key, that key's values — and label keys and
    values come from the stores that ARE there, so it cannot offer one
    nothing carries."""

    def __init__(self, sh):
        self.sh = sh

    def offers(self, slot):
        """What may be typed at one `<placeholder>`. An empty answer is
        "anything" — a name, a time, a count — where offering a guess
        would be worse than offering nothing."""
        return {
            "<kind>": list(KINDS),
            "<source>": sorted(self.sh.views) + ["["],
            "<view>": sorted(self.sh.views),
            "<cursor>": sorted(self.sh.cursors),
            "<host>": [label(h) for h in TARGETS if h],
            "<pred>": ["["],
        }.get(slot, [])

    def after(self, form, toks):
        """What this FORM allows after `toks`, or None where it does not
        match them at all. One walk of one shape; `options` unions it over
        every shape, which is the whole completer now."""
        slots, i = form.split(), 0
        for j, slot in enumerate(slots):
            if slot.endswith("...>"):
                return self.sub(slot, toks[i:])
            if i >= len(toks):
                return [slot] if not slot.startswith("<") else self.offers(slot)
            if not slot.startswith("<") and toks[i].lower() != slot:
                return None                       # a different statement
            i += 1
        return [] if i >= len(toks) else None

    def sub(self, slot, rest):
        """The parts that repeat or nest, which a flat shape cannot say."""
        prev = rest[-1].lower() if rest else None
        if slot in ("<clauses...>", "<tailclauses...>"):
            # `where ... [limit N [chunks]] [into view]`, in any order the
            # parser takes them, and each of them once.
            if prev in ("where", "and"):
                return SUBJECTS
            if prev == "entry":
                return AFTER_ENTRY
            if prev == "chunk":
                return ["may"]
            if prev == "may":
                return ["have"]
            if prev == "not":
                return ["has", "substring", "regex"]
            if prev in ("logline", "written", "write"):
                return AFTER_TIME
            if prev in ("limit", "into"):
                return ["view"] if prev == "into" else []
            low = [t.lower() for t in rest]
            # `into view` is a SELECT's. A tail does not end, so it has no
            # answer to put in a view — and the completer must not offer
            # what the parser refuses.
            clauses = ("where", "limit") if slot == "<tailclauses...>" \
                else ("where", "limit", "into")
            return [w for w in clauses if w not in low] \
                + (["and"] if "where" in low else [])
        if slot == "<at...>":
            if prev in ("chunk", "offset"):
                return []
            return ["at"] if not rest else (
                ["chunk", "offset"] if prev == "at" else [])
        if slot == "<ends...>":
            given = {t.lower() for t in rest}
            return [e for e in ("from", "to") if e not in given]
        if slot == "<statement...>":
            # Past `for` it IS a statement, so it completes as one rather
            # than teaching this a second copy of the grammar.
            return self.options(" ".join(rest) + " ", "") if rest \
                else ["select", "tail"]
        return []

    def options(self, line, word):
        """Everything any statement shape allows at this point.

        The grammar earns its keep here: at every point exactly one kind of
        thing can come next, so the completer never has to guess. It reads
        FORMS and nothing else — label keys and values come from the stores
        that ARE there, so it cannot offer one nothing carries."""
        # A backslash command and the inside of a predicate literal are
        # not statement shapes: one is a different language, the other is
        # the internals of a single token.
        if line.lstrip().startswith("\\"):
            toks = line.split()
            if len(toks) + (1 if line.endswith(" ") else 0) > 1:
                return sorted(x["name"] for x in self.sh.universe())
            return BACKSLASH
        if word.startswith("["):
            body = word[1:]
            head, _, tail = body.rpartition(",")
            for op in OPS:
                if op in tail:
                    k, part = tail.split(op, 1)
                    pre = f"[{head},{k}{op}" if head else f"[{k}{op}"
                    return [pre + v for v in sorted(self.sh.values_of(k))]
            pre = f"[{head}," if head else "["
            return [pre + k + "=" for k in sorted(self.sh.keys_of())]

        toks = line.split()
        # A partial last word is what is being completed, not something
        # already typed.
        if toks and not line.endswith(" "):
            toks = toks[:-1]
        out = []
        for form in FORMS.split("\n"):
            form = form.strip()
            if not form:
                continue
            got = self.after(form, toks)
            if got:
                out += [o for o in got if o not in out]
        return out

    def __call__(self, text, state):
        line = readline.get_line_buffer()[: readline.get_endidx()]
        try:
            opts = [o for o in self.options(line, text) if o.startswith(text)]
        except Exception:
            opts = []
        return opts[state] if state < len(opts) else None


# ----------------------------------------------------------------- main
class Shell:
    def __init__(self):
        # The investigation's window: every statement is read inside it,
        # and the pager will not scroll out of it. None until asked for.
        self.session = None
        self.views = {}
        self.cursors = {}
        self.names = {}
        self._universe = None
        self._universe_at = 0.0
        self.unreachable = {}
        # host -> {version, error, note, seen}: what each one last said,
        # so `show hosts;` can answer "what am I talking to, and did
        # anything go wrong" without a second round trip.
        self.hosts = {}
        self._universe_lock = threading.Lock()
        # Filled in the background: against a remote forest the round trip
        # is seconds, and paying it on the first TAB is what makes
        # completion feel broken rather than slow.
        threading.Thread(target=self.universe, daemon=True).start()
        if os.path.exists(RC):
            self.load(RC, quiet=True)

    def ask(self, doc, host=None, raw=False):
        """One host, waited for. `ask_stream` is the same call read as it
        arrives; both record what the host said."""
        started = time.monotonic()
        out, err, rc = run(doc, host, raw)
        self.record(host, started, err, rc)
        return out, err, rc

    def ask_stream(self, doc, host, emit, framed=True):
        """`stream`, with the same bookkeeping `ask` does."""
        started = time.monotonic()
        err, rc = stream(doc, host, emit, framed)
        self.record(host, started, err, rc)
        return err, rc

    def record(self, host, started, err, rc):
        """What a host said, kept rather than thrown away.

        timberfs writes its explanations to stderr and still exits 0 — `no
        store matches ...`, `retention overtook this follower`, a coverage
        warning. Those are exactly the sentences that answer "why did I get
        nothing", and they were being discarded on every successful call."""
        st = self.hosts.setdefault(host, {})
        # Stamped BEFORE the call, and a later call never loses to an
        # earlier one that happened to finish after it. The prewarm thread
        # runs alongside whatever is typed first, so without this the
        # startup listing could land last and erase the note from the
        # command the person actually ran.
        if started < st.get("at", 0):
            return
        st["at"] = started
        st["seen"] = True
        if rc != 0:
            st["error"] = err or f"exit {rc}"
        else:
            st.pop("error", None)
            # Kept, not printed: a note is context for an answer that looks
            # wrong, and printing every one would bury the answer.
            st["note"] = err or None

    def universe(self, fresh=False):
        """Every store on every host, cached for STORE_TTL seconds.

        Completion must not cost a round trip per keystroke, and against a
        remote forest that trip is seconds. But it cannot be cached forever
        either: a logview is a PREDICATE precisely so a store that appears
        later is in it, and a completer offering a set that can no longer
        change would contradict that. So it expires rather than being
        pinned, and `fresh` forces a read where being right beats being
        quick.

        Kept for the whole session by default (STORE_TTL 0) — `refresh`
        re-reads it, and does so when you know something changed rather
        than on a timer that mostly finds nothing.

        Hosts are read in PARALLEL, so N of them cost the slowest one
        rather than the sum. Each store is tagged with where it lives; a
        host that could not be reached is remembered separately and named
        in every listing, because a short list and a broken one look
        identical."""
        with self._universe_lock:
            stale = self._universe is None or (
                STORE_TTL > 0 and time.monotonic() - self._universe_at > STORE_TTL)
            if not (fresh or stale):
                return self._universe
            doc = {"v": "1.0-EXPERIMENTAL", "stores": {"select": []},
                   "response_format": {"kind": "stores"}}
            got, bad, lock = [], {}, threading.Lock()

            def one(host):
                out, err, rc = self.ask(doc, host)
                with lock:
                    if rc != 0:
                        bad[host] = err or f"exit {rc}"
                        return
                    try:
                        stores, ver = unwrap(out)
                    except json.JSONDecodeError as e:
                        bad[host] = f"not JSON: {e}"
                        return
                    self.hosts.setdefault(host, {})["version"] = ver
                    for st in stores:
                        st["_host"] = host
                    got.extend(stores)

            ts = [threading.Thread(target=one, args=(h,)) for h in TARGETS]
            for t in ts:
                t.start()
            for t in ts:
                t.join()
            self._universe, self.unreachable = got, bad
            self._universe_at = time.monotonic()
            return self._universe

    def expand_ids(self, terms):
        """A short id is INPUT here and never leaves: it is resolved to the
        whole one before the document is built, the way a short SHA works.

        Nothing is guessed — the store list says which id it is, or that it
        is ambiguous, and an ambiguous one is refused rather than picked
        from. That is the difference between this and rewriting a query on
        a hunch: an exact `id=` on the wire still means exactly itself."""
        for t in terms:
            v = t.get("value", "")
            if t.get("key") != "id" or t.get("op") not in ("=", "!="):
                continue
            if len(v) >= 36 or not v:
                continue
            hits = self.ids_starting(v)
            if not hits:
                # A store created since the cache was filled is the one
                # reason to pay for a re-read here.
                hits = self.ids_starting(v, fresh=True)
            if len(hits) == 1:
                t["value"] = hits[0]
            elif not hits:
                raise ValueError(f"no store has an id starting {v!r}")
            else:
                raise ValueError(
                    f"{v!r} is ambiguous — {len(hits)} stores start with it: "
                    + ", ".join(h[:12] for h in sorted(hits)))
        return terms

    def paths_on(self, host):
        """path -> store name, for the stores on ONE host. Per host because
        two machines can hold the same path, and the answer being rendered
        came from exactly one of them."""
        return {st["path"]: st["name"] for st in self.universe()
                if st.get("path") and st.get("_host") == host}

    def ids_starting(self, prefix, fresh=False):
        p = prefix.lower()
        return [s["id"] for s in self.universe(fresh)
                if (s.get("id") or "").lower().startswith(p)]

    def keys_of(self):
        # `name` and `id` are not labels, but the selector matches the whole
        # manifest, so they are selectable and belong in completion.
        return {"name", "id"} | {k for s in self.universe()
                                 for k in (s.get("labels") or {})}

    def values_of(self, key):
        if key == "name":
            return {s["name"] for s in self.universe() if s.get("name")}
        # The WHOLE id: `id=` is an exact match, and the 8 characters the
        # listing prints are a prefix that would select nothing.
        if key == "id":
            return {s["id"] for s in self.universe() if s.get("id")}
        return {str(v) for s in self.universe()
                for k, v in (s.get("labels") or {}).items() if k == key}

    def window(self):
        """The session as the viewer takes it: `(from_ms, to_ms)`, or None.

        The same window the statements are read inside, so the pager a hit
        opens into cannot wander out of the investigation the query was
        bounded by — which it could, being a tape with no predicate."""
        if not self.session:
            return None
        return (self.session.get("from"), self.session.get("to"))

    def parse_session(self, toks):
        """`from T`, `to T`, or both — either end may be left open, which
        is still a rail on the other."""
        window, i = {}, 0
        while i < len(toks):
            w = toks[i][1].lower()
            if w in ("from", "since", "after") and i + 1 < len(toks):
                window["from"] = when(toks[i + 1][1]); i += 2
            elif w in ("to", "until", "before") and i + 1 < len(toks):
                window["to"] = when(toks[i + 1][1]); i += 2
            elif w == "and":
                i += 1
            else:
                raise ValueError(
                    f"`{toks[i][1]}`? create session from <time> to <time> "
                    f"— either end may be left out")
        if not window:
            raise ValueError("create session from <time> to <time>")
        if "from" in window and "to" in window \
                and window["from"] > window["to"]:
            raise ValueError("that session starts after it ends")
        return window

    def source(self, tok):
        # Every path that turns text into terms comes through here, so this
        # is the one place a short id has to be expanded — including the
        # terms a `create logview` stores, which keeps a saved view exact.
        if tok[0] == "pred": return self.expand_ids(parse_pred(tok[1]))
        if tok[1] in self.views: return self.views[tok[1]]
        raise ValueError(f"no logview `{tok[1]}` — `show logviews;` lists them")

    def load(self, path, quiet=False):
        n = 0
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("--"):
                self.do(line); n += 1
        if not quiet: print(f"  {n} statement(s) from {path}")

    def save(self, path):
        # Never defaults to the startup file. That file is a SCRIPT — it
        # may hold selects, settings, anything — and writing back only the
        # views would silently delete the rest of what it does.
        if path is None:
            raise ValueError(
                "`save` needs a file. It writes only the logviews, and the "
                f"startup script ({RC}) may do more than define them")
        with open(path, "w") as f:
            for name, terms in sorted(self.views.items()):
                pred = ",".join(f"{t['key']}{t['op']}{t['value']}" for t in terms)
                f.write(f"create logview [{pred}] {name};\n")
        print(f"  {len(self.views)} logview(s) -> {path}")

    def show_views(self):
        if not self.views: print("  no logviews"); return
        for n, t in sorted(self.views.items()):
            print(f"  {n:14} [{','.join(x['key']+x['op']+x['value'] for x in t)}]")

    def backslash(self, line):
        """psql's muscle memory. Terminated by the newline, not by `;` —
        typing `\\d;` is not what fingers do."""
        cmd, _, arg = line[1:].strip().partition(" ")
        arg = arg.strip().rstrip(";")
        if cmd in ("q", "quit"): raise SystemExit
        if cmd in ("?", "h", "help"): print(HELP); return
        if cmd == "dv": return self.show_views()
        if cmd.rstrip("+") != "d":
            raise ValueError(f"`\\{cmd}`? this shell knows \\d \\d+ \\dv \\? \\q")
        # Fetched whole and filtered here, rather than asked for by
        # predicate. The selector is a CONJUNCTION, and this has to match a
        # name OR an id prefix; a prefix is not an operator it has anyway.
        # It also cannot go wrong across versions, which `=*` did.
        # The cached list: `\\d` is the QUICK look, and the query path
        # below is the one that is always current.
        stores = self.universe()
        if arg:
            a = arg.lower()
            stores = [x for x in stores
                      if a in (x.get("name") or "").lower()
                      or (x.get("id") or "").lower().startswith(a)]
        if not stores:
            # Through the same reporting as a non-empty answer. An empty
            # list is exactly what a fleet of unreachable hosts produces,
            # and returning early here said "no stores" for "nothing
            # worked" — the failure this shell keeps being written to stop.
            show_unreachable(self.unreachable)
            if self.unreachable and len(self.unreachable) == len(TARGETS):
                print(f"  no host answered, so nothing was listed")
            else:
                print(f"  no store matches {arg!r}" if arg else "  no stores")
            return
        # Named one thing: describe it, as `\\d relation` does. Named
        # several: list them, so the name can be narrowed.
        if arg and len(stores) == 1:
            return describe_store(stores[0])
        return show_stores(stores, verbose=cmd.endswith("+"),
                           unreachable=self.unreachable)

    def do(self, line):
        global FLEET, TARGETS
        if line.lstrip().startswith("\\"):
            return self.backslash(line.lstrip())
        toks = [t for t in lex(line) if t[1] != ";"]
        if not toks: return
        head = toks[0][1].lower()
        if head in ("quit", "exit"): raise SystemExit
        if head == "help": print(HELP); return
        if head == "save": self.save(toks[1][1] if len(toks) > 1 else None); return
        if head == "load": self.load(toks[1][1] if len(toks) > 1 else RC); return
        if head in ("add", "drop") and len(toks) > 1 \
                and toks[1][1].lower().startswith("host"):
            if len(toks) < 3:
                raise ValueError(f"{head} host <name> [name ...]")
            names = [t[1] for t in toks[2:] if t[1] != ","]
            now = [t for t in FLEET.targets if t.name]
            for n in names:
                if head == "add":
                    if any(t.name == n for t in now):
                        raise ValueError(f"`{n}` is already there")
                    # A host needs a command to be reached BY, and only
                    # the `--cmd` shape carries one that generalises. A
                    # resolver derives its answer, so the way to add a
                    # host there is to add it there and `refresh`.
                    if not FLEET.template:
                        raise ValueError(
                            f"the fleet comes from {FLEET.source}, which says "
                            f"how to reach each target — there is no command "
                            f"to reach `{n}` with. Add it there and `refresh`")
                    now.append(timberfs_client.Target(
                        n, cmd=[a.replace(timberfs_client.HOST_TOKEN, n)
                                for a in FLEET.template]))
                else:
                    if not any(t.name == n for t in now):
                        raise ValueError(
                            f"no host `{n}` — `show hosts;` lists them")
                    now = [t for t in now if t.name != n]
            if not now:
                raise ValueError(
                    "that is the last host; a shell with none has nothing to ask")
            FLEET = FLEET.with_targets(now)
            TARGETS = FLEET.names
            # The cached stores are tagged with the host they came from, so
            # a changed set makes the cache answer for a fleet that is no
            # longer the one being asked.
            for h in list(self.hosts):
                if h not in TARGETS:
                    del self.hosts[h]
            self.universe(fresh=True)
            print(f"  {len(TARGETS)} host(s): {', '.join(label(h) for h in TARGETS)}")
            show_unreachable(self.unreachable)
            return
        if head == "refresh":
            was = set(FLEET.names)
            try:
                FLEET = FLEET.again()
            except ValueError as e:
                raise ValueError(f"the fleet could not be re-resolved: {e}")
            TARGETS = FLEET.names
            gained, lost = set(FLEET.names) - was, was - set(FLEET.names)
            if gained or lost:
                bits = [f"{len(TARGETS)} target(s) from {FLEET.source}"]
                if gained:
                    bits.append("new: " + ", ".join(sorted(map(label, gained))))
                if lost:
                    bits.append("gone: " + ", ".join(sorted(map(label, lost))))
                print("  " + "   ".join(bits))
            for h in list(self.hosts):
                if h not in TARGETS:
                    del self.hosts[h]
            before = {st.get("id") or st["name"]: st["name"]
                      for st in self.universe()}
            after = {st.get("id") or st["name"]: st["name"]
                     for st in self.universe(fresh=True)}
            new = [n for k, n in after.items() if k not in before]
            gone = [n for k, n in before.items() if k not in after]
            bits = [f"{len(after)} store(s)"]
            if new:
                bits.append(f"new: {', '.join(sorted(new))}")
            if gone:
                bits.append(f"gone: {', '.join(sorted(gone))}")
            if not new and not gone:
                bits.append("unchanged")
            print("  " + "   ".join(bits))
            show_unreachable(self.unreachable)
            return
        if head == "create" and len(toks) > 1 \
                and toks[1][1].lower() == "session":
            # `create session from '13:00' to '14:00'` — the investigation's
            # own window, which every statement is then read inside and the
            # pager will not scroll out of. Re-creating replaces it, the way
            # a window you are adjusting should.
            self.session = self.parse_session(toks[2:])
            print(f"  session {show_window(self.session)}")
            return
        if head == "drop" and len(toks) > 1 \
                and toks[1][1].lower() == "session":
            if self.session is None:
                raise ValueError("no session — `create session from ... to ...`")
            self.session = None
            print("  session dropped; statements are unbounded again")
            return
        if head == "show" and len(toks) > 1 \
                and toks[1][1].lower() == "session":
            print(f"  session {show_window(self.session)}" if self.session
                  else "  no session — every statement is read unbounded")
            return
        if head == "show" and len(toks) > 1 and toks[1][1].lower().startswith("host"):
            self.universe()  # cheap: cached, and it is what fills this in
            print(f"  {len(TARGETS)} target(s), from {FLEET.source}")
            if FLEET.refresh:
                # Getting the fleet and re-asking for it are allowed to be
                # different commands, so which one `refresh` runs is not
                # derivable from where the fleet came from.
                print(f"  refresh asks {FLEET.refresh.describe()}"
                      f"   ({FLEET.refresh_source})")
            for name, why in FLEET.unusable:
                print(f"  ⚠ {label(name)} was not asked: {why}")
            w = max([len(label(h)) for h in TARGETS] + [4])
            print(f"  {'HOST':{w}}  {'VERSION':20}  STORES  STATUS")
            for host in TARGETS:
                st = self.hosts.get(host, {})
                n = sum(1 for x in self.universe() if x.get("_host") == host)
                # An older timberfs answers with the bare array and no
                # version at all, which is a FACT about it rather than a
                # gap in the listing.
                if st.get("error"):
                    # It did not answer, so it said nothing about itself —
                    # which is not the same as answering without the field.
                    ver, n = "-", "-"
                    status = f"UNREACHABLE — {fmt_err(st['error'])}"
                elif not st.get("seen"):
                    ver, n, status = "-", "-", "not asked yet"
                else:
                    # Answered, but with no version in it: a timberfs from
                    # before the field existed. A fact about that host.
                    ver = st.get("version") or "(not reported)"
                    status = "ok"
                print(f"  {label(host):{w}}  {ver:20}  {str(n):>6}  {status}")
                # The note timberfs printed and still exited 0 on. Kept
                # because it is the sentence that explains an answer which
                # looks wrong, and it used to be discarded.
                # What actually runs. It is per target now, so a fleet
                # reached several different ways says so here rather
                # than being assumed uniform.
                t = FLEET.by_name(host)
                if t:
                    print(f"  {'':{w}}  via: {t.via}")
                if st.get("note"):
                    for line in st["note"].splitlines():
                        if line.strip():
                            print(f"  {'':{w}}  note: {line.strip()[:100]}")
            return
        if head == "show":
            if toks[1][1].lower().startswith("cursor"):
                if not self.cursors: print("  no cursors"); return
                for n, c in sorted(self.cursors.items()):
                    at = (", ".join(f"{p['id'][:8]}@{p.get('offset','-')}"
                                    for p in c["at"]) or "(not started)")
                    print(f"  {n:14} at {at}\n  {'':14}    {c['stmt']}")
                return
            return self.show_views()
        if head == "drop":
            if len(toks) < 3 or toks[1][1].lower() != "logview":
                raise ValueError("drop logview <name>")
            name = toks[2][1]
            # Succeeding on a name that is not there hides the typo AND
            # leaves the view you meant to drop in place, so the next
            # query still runs against it.
            if self.views.pop(name, None) is None:
                raise ValueError(f"no logview `{name}` — `show logviews;` lists them")
            return
        if head == "create":
            if len(toks) < 4 or toks[1][1].lower() != "logview":
                raise ValueError("create logview <name> [predicate]")
            # EITHER ORDER, and `as` optional. A predicate literal is
            # `[...]` and a name is not, so the tokens say which is which —
            # that is what the literal is FOR, and it costs nothing to let
            # SQL's habit (`create view name as ...`) work too.
            rest = [t for t in toks[2:] if t[1].lower() != "as"]
            pred = [t for t in rest if t[0] == "pred"]
            name = [t for t in rest if t[0] != "pred"]
            if len(pred) != 1 or len(name) != 1:
                raise ValueError(
                    "create logview <name> [predicate] — one name and one "
                    "[predicate], in either order")
            self.views[name[0][1]] = self.source(pred[0])
            return
        if head == "declare":
            # `declare errs cursor for select records from console where ...`
            name = toks[1][1]
            if toks[2][1].lower() != "cursor" or toks[3][1].lower() != "for":
                raise ValueError("declare <name> cursor for <select ...>")
            inner = line[line.lower().index(" for ") + 5:]
            self.cursors[name] = {"stmt": inner.rstrip(" ;"), "at": []}
            print(f"  cursor {name}")
            return
        if head == "close":
            if len(toks) < 2:
                raise ValueError("close <cursor>")
            name = toks[1][1]
            if self.cursors.pop(name, None) is None:
                raise ValueError(f"no cursor `{name}` — `show cursors;` lists them")
            return
        if head == "fetch":
            n = int(toks[1][1])
            if toks[2][1].lower() != "from": raise ValueError("fetch N from <cursor>")
            cur = self.cursors.get(toks[3][1])
            if cur is None: raise ValueError(f"no cursor `{toks[3][1]}`")
            return self.fetch(cur, n)
        if head == "view":
            if len(toks) < 2:
                raise ValueError(
                    "view <source> [at <time> | at chunk N | at offset N]  "
                    "-- `view []` is every store")
            return self.view(toks)
        if head in ("select", "tail"):
            kind = toks[1][1].lower()
            if kind not in KINDS: raise ValueError(f"`{kind}`? one of {KINDS}")
            if toks[2][1].lower() != "from": raise ValueError("expected `from`")
            terms = self.source(toks[3])
            conds, i = [], 4
            if i < len(toks) and toks[i][1].lower() == "where":
                conds, i = parse_where(toks, i + 1)
            # `limit` and `into view` in either order, and NOTHING else
            # after them. `into view limit 1` used to parse as `into view`
            # and drop the bound without a word, which turns one entry
            # into a read of the whole store on every host.
            limit, into = None, False
            while i < len(toks):
                w = toks[i][1].lower()
                if w == "limit" and limit is None:
                    if i + 1 >= len(toks) or not toks[i + 1][1].isdigit():
                        raise ValueError("`limit` wants a number")
                    n, i = int(toks[i + 1][1]), i + 2
                    unit = toks[i][1].lower() if i < len(toks) else "entries"
                    if unit.startswith(("entr", "chunk")):
                        i += 1
                    limit = {"chunks" if unit.startswith("chunk")
                             else "entries": n}
                elif w == "into" and not into:
                    if i + 1 >= len(toks) or toks[i + 1][1].lower() != "view":
                        raise ValueError("`into` what? `into view` is the one there is")
                    into, i = True, i + 2
                else:
                    raise ValueError(
                        f"`{toks[i][1]}`? after the source come `where ...`, "
                        f"`limit N [chunks]` and `into view`, each once")
            notes = []
            doc = build(kind, terms, conds, limit, self.session, notes)
            for note in notes:
                print(note)
            if into:
                if head != "select":
                    raise ValueError("`tail` does not end, so it has no answer "
                                     "to put in a view")
                return self.into_view(doc, kind, line)
            if head == "tail": return self.tail(doc)
            return self.once(doc, kind)
        raise ValueError(f"`{head}`? try `help`")

    def into_view(self, doc, kind, line):
        """The answer, in the pager instead of on the terminal.

        `select` walks a result set and `view` walks the log — different
        motions, and this puts the first on the second's screen. It
        works because an entry record carries `chunk` and `offset`, so
        every line in the answer knows where it CAME from: Tab and the
        search work as they do anywhere, and Enter leaves the answer for
        the log around that entry."""
        # The statement is wrong or right wherever it is run, so it is
        # judged before the terminal is.
        if kind != "records":
            raise ValueError(
                f"`select {kind} ... into view` cannot work — only `records` "
                f"carries the offset a line needs to say where it came from, "
                f"and without one nothing in the answer could be opened.\n"
                f"     Ask for `select records ...`.")
        if not sys.stdout.isatty():
            raise ValueError("`into view` needs a terminal")
        # An answer screen is a CLOSED set — it materialises every entry it
        # is handed — so this is bounded to one page rather than paged to
        # the end: walking a gigabyte into it would only move where the
        # memory goes. The screen says the answer continues; an explicit
        # `limit` is taken as typed.
        if not doc.get("max"):
            doc = dict(doc, max={"entries": PAGE})
        backend = timberview.QueryBackend(self.ask, TARGETS)
        # The statement names the answer, minus the part that says where
        # to put it — which the screen it is on already says.
        what = re.sub(r"\s+into\s+view\s*;?\s*$", "", line.strip(),
                      flags=re.I).rstrip(";")
        streams = backend.records(doc)
        # Which hosts refused THE READ. `unreachable` follows the last
        # question asked, and the store listing on the next line asks
        # another one — a host that answers that would erase the refusal
        # which is the whole reason the answer is short.
        refused = dict(backend.unreachable)
        answer = timberview.Records(streams, stores=backend.stores(), what=what)
        if not answer.entries:
            # What the hosts SAID goes with the empty answer, not after a
            # viewer that is never opened.
            print(self.why_empty(doc, refused))
            return
        end = timberview.watch_source(backend, answer)
        report_errors({**refused, **backend.unreachable})
        print(f"  {end}" if end else "  -- left the answer")

    def view(self, toks):
        """A pager over the tape, IN PROCESS.

        The loop is search, jump, search again. A separate command would
        have to leave the screen carrying "search this token", let the
        shell print, and re-enter at a coordinate — a flicker per hop,
        which is the opposite of what a viewer is for."""
        if not sys.stdout.isatty():
            raise ValueError("`view` needs a terminal")
        backend = timberview.QueryBackend(self.ask, TARGETS)
        tok = toks[1]
        if tok[0] == "str" and tok[1].startswith(timberview.SCHEME + ":"):
            addr = timberview.parse_address(tok[1])
            terms = self.expand_ids(
                [{"key": "id", "op": "=", "value": addr.store}])
            pos = timberview.position(str(addr))
            rest = 2
        else:
            terms = self.source(tok)
            pos, rest = self.view_at(toks, 2)
        if rest < len(toks):
            raise ValueError(f"`{toks[rest][1]}`? nothing follows a position")
        stores = backend.select_stores(terms)
        if not stores:
            # A host that did not answer contributes no stores, so an
            # empty list is not evidence that the predicate is wrong.
            report_errors(backend.unreachable)
            answered = len(TARGETS) - len(backend.unreachable)
            if not answered:
                raise ValueError("nothing answered, so there is nothing to open")
            raise ValueError(
                "that predicate selects NO STORE"
                + (f" on the {answered} that answered" if backend.unreachable
                   else f" on any of {len(TARGETS)} hosts" if len(TARGETS) > 1
                   else "") + ", so there is nothing to open")
        try:
            end = timberview.watch(backend, stores[0], window=self.window(),
                                   **pos)
        except timberview.Refused as e:
            raise ValueError(str(e))
        if len(stores) > 1:
            print(f"  -- 1 of {len(stores)} stores matched; S switches "
                  "between them")
        print(f"  {end}")

    def view_at(self, toks, i):
        """`at` names a coordinate and says which one it is: a time, a
        chunk number, or an offset are three different numbers."""
        if i >= len(toks):
            return {}, i
        if toks[i][1].lower() != "at":
            raise ValueError(
                f"`{toks[i][1]}`? after a source comes `at <time>`, "
                "`at chunk N` or `at offset N`")
        i += 1
        if i >= len(toks):
            raise ValueError("`at` what? a time, `chunk N` or `offset N`")
        w = toks[i][1].lower()
        if w in ("chunk", "offset"):
            i += 1
            if i >= len(toks) or not toks[i][1].isdigit():
                raise ValueError(f"`at {w}` wants a number")
            return ({"seq": int(toks[i][1])} if w == "chunk"
                    else {"offset": int(toks[i][1])}), i + 1
        return {"at": when(toks[i][1])}, i + 1

    def fetch(self, cur, n):
        """One page, from a real cursor: the positions the last answer
        reported, handed straight back. Byte-exact on each store's tape,
        so entries sharing a timestamp are still six distinct places."""
        toks = [t for t in lex(cur["stmt"]) if t[1] != ";"]
        kind = toks[1][1].lower()
        terms = self.source(toks[3])
        conds, i = [], 4
        if i < len(toks) and toks[i][1].lower() == "where":
            conds, i = parse_where(toks, i + 1)
        doc = build(kind, terms, conds, {"entries": n}, self.session)
        # The WHOLE cursor goes to every host. A position names a store by
        # id, ids are uuids, and a host simply never looks up one it does
        # not have — so nothing has to be routed and a page can straddle
        # machines. (Verified against timberfs: an unknown id in `cursor` is
        # ignored, and the known one still resumes.)
        if cur["at"]:
            doc["cursor"] = cur["at"]
        # Positions MERGE onto the ones already held rather than replacing
        # them. A store that delivered nothing this page reports a position
        # with NO offset — and an offsetless entry means "start of the
        # window", so taking the answer at face value would re-read every
        # store that happened to go quiet. Keep what we had for those.
        at = {p["id"]: p for p in cur["at"]}
        shown, more, bad = 0, False, {}
        for host in TARGETS:
            if shown >= n:
                break
            d = dict(doc, max=dict(doc["max"], entries=n - shown))
            out, err, rc = self.ask(d, host)
            if rc != 0:
                bad[host] = err or f"exit {rc}"
                continue
            for k, f, payload in records(out):
                if k == "source":
                    self.names[f.get("id", "?")] = os.path.basename(f.get("path", "?"))
                elif k == "entry":
                    who = self.names.get(f.get("id", ""), "")
                    where = f"{label(host)} " if len(TARGETS) > 1 else ""
                    print(f"  {where}{who:28} {(payload or '').rstrip()}")
                    shown += 1
                # Every store EXAMINED reports one, barren ones included —
                # drop those and the next page rescans them from the
                # window's start. Across hosts they simply accumulate.
                elif k == "position" and f.get("id"):
                    if "offset" in f:
                        at[f["id"]] = {"id": f["id"], "offset": int(f["offset"])}
                    else:
                        at.setdefault(f["id"], {"id": f["id"]})
                elif k == "stream-end" and f.get("status") == "limited":
                    more = True
        report_errors(bad)
        # A host left unread has more by definition, whatever the ones that
        # did run said.
        if shown >= n and len(TARGETS) > 1:
            more = True
        if more:
            print(f"  -- more: `fetch {n} from ...` again")
        elif not shown:
            print("  -- nothing more (for now)")
        cur["at"] = list(at.values())

    def next_page(self, out, at):
        """Where this page got to, merged into the cursor. True if a bound
        stopped the read, which is what says there is more.

        Positions MERGE onto what is already held rather than replacing
        it. Every store EXAMINED reports one, barren ones included — drop
        those and the next page rescans them from the window's start,
        which on a fleet is most of the cost. A store that delivered
        nothing reports the position it was RESUMED from, so paging past a
        quiet store cannot lose its place. Across hosts they accumulate:
        a position names a store by id, and a host never looks up one it
        does not have."""
        more = False
        for k, f, _ in records(out):
            if k == "position" and f.get("id"):
                if "offset" in f:
                    at[f["id"]] = {"id": f["id"], "offset": int(f["offset"])}
                else:
                    at.setdefault(f["id"], {"id": f["id"]})
            elif k == "stream-end" and f.get("status") == "limited":
                more = True
        return more

    def why_empty(self, doc, bad=None):
        """Nothing came back — was anything even SEARCHED?

        "no store matched the predicate" and "the stores held no matching
        entry" are opposite problems and look identical from an empty
        answer. Only asked when the answer IS empty, so the extra request
        is paid on the confusing case and nowhere else.

        A host that did not ANSWER is the third case, and counting it as
        the first repeats the mistake one layer down: it holds an unknown
        number of matching stores, so a fleet that refused cannot be
        evidence about the predicate. `bad` is what already failed — those
        hosts are named, not asked a second time."""
        bad = dict(bad or {})
        probe = {k: v for k, v in doc.items() if k in ("v", "stores")}
        probe["response_format"] = {"kind": "stores"}
        n = 0
        for host in TARGETS:
            if host in bad:
                continue
            out, err, rc = self.ask(probe, host)
            if rc != 0:
                bad[host] = err or f"exit {rc}"
            else:
                n += len(unwrap(out)[0])
        report_errors(bad)
        if n:
            return f"  -- nothing matched, in {n} store(s)"
        if len(bad) == len(TARGETS):
            return "  -- nothing answered, so the predicate was never tried"
        return ("  -- that predicate selects NO STORE"
                + (f" on the {len(TARGETS) - len(bad)} that answered" if bad
                   else f" on any of {len(TARGETS)} hosts" if len(TARGETS) > 1
                   else "")
                + ", so nothing was searched")

    def fan_out(self, doc):
        """One document to every host AT ONCE, as {host: (out, err, rc)}.

        There is no point asking first whether a host holds a matching
        store: a read whose predicate matches nothing resolves to nothing
        and returns immediately — measured at the same 0.00 s as the
        question "do you have one". The cost was never the search, it was
        N round trips taken one after another."""
        answers, lock = {}, threading.Lock()

        def one(host):
            out, err, rc = self.ask(doc, host)
            with lock:
                answers[host] = (out, err, rc)

        if len(TARGETS) > 1:
            ts = [threading.Thread(target=one, args=(h,)) for h in TARGETS]
            for t in ts:
                t.start()
            for t in ts:
                t.join()
        else:
            one(TARGETS[0])
        return answers

    def once(self, doc, kind):
        # A `stores` answer is a SET, so the hosts merge into one listing.
        if kind == "stores":
            return self.list_stores(doc)
        # `chunks` is compressed frames for a machine — written through
        # untouched, so there is nothing to render and nothing an arrival
        # order could help.
        if kind == "chunks":
            return self.once_raw(doc)

        want = doc.get("max", {}).get("entries")
        # ⚠ Paged only where every entry that comes back is SHOWN.
        #
        # A `limit` is a total across hosts, enforced here, so a host is
        # asked for the whole bound and its surplus entries are read and
        # then dropped. Its `position` records cover what it DELIVERED, so
        # a cursor built from that page resumes past exactly the entries
        # nobody saw. An unbounded read shows all of it, and the positions
        # are then what they say they are.
        #
        # Only `records` carries a `position` record at all, so the other
        # kinds cannot be continued and are left as one call rather than
        # bounded into a silent truncation.
        paged = want is None and kind == "records"
        total, bad, at, pages, dropped = 0, {}, {}, 0, 0
        shown_by = {}
        while True:
            d = doc
            if paged:
                d = dict(doc, max={"entries": PAGE})
                if at:
                    d["cursor"] = list(at.values())
            room = None if want is None else want - total
            n, more, page_dropped = self.render_page(d, kind, room, at, shown_by, bad)
            total += n
            dropped += page_dropped
            pages += 1
            # ⚠ `more` is the server saying a bound stopped it, which is
            # true of the CALLER's `limit` too — so only a paged read may
            # act on it. Without this an unpaged one re-sends the same
            # document for ever.
            if not (paged and more):
                break
        empty = [h for h in TARGETS if h not in bad and not shown_by.get(h)]
        # The count is said once, as a fleet total. Per host it would be
        # the server's own `stream-end` line, which while paging says
        # `limited` on every page but the last — this shell's own bound,
        # not a truncation of the answer.
        if paged and total:
            print(f"  -- {total} entries"
                  + (f", in {pages} pages of {PAGE}" if pages > 1 else ""))
        if dropped:
            # Which entries a bounded fleet read returns is now decided by
            # ARRIVAL, so saying how many were read past the bound is
            # saying that the answer is a sample of a larger one.
            print(f"  -- stopped at {want}; {dropped} more had already arrived")
        # NOTHING came back, and nothing failed. Which host had nothing is
        # then the one thing that does not matter: every host has nothing,
        # and the tally reads identically whether the stores held no
        # matching entry or the predicate selected no store at all. Say
        # which — it costs one round trip, on the case that needs it.
        if not total and not bad:
            note = self.why_empty(doc)
            if note:
                print(note)
        # A host with nothing is counted, not given a line of its own:
        # six such lines is noise standing where an answer should be.
        elif empty and len(TARGETS) > 1:
            print(f"  -- nothing on {len(empty)}: "
                  + ", ".join(label(h) for h in TARGETS if h in empty))
        report_errors(bad)

    def render_page(self, doc, kind, room, at, shown_by, bad):
        """One round to every host, rendered AS IT ARRIVES.

        Interleaved, in arrival order, because the alternative is what the
        buffering cost: with the answers collected first and replayed host
        by host, the fastest host's first line waited for the slowest
        host's last one — measured at 1.9 s for a line that was ready at
        0.3 s. No ordering is lost by it. Within a host a bounded answer is
        `order=sequential` — store after store, not time — and ACROSS hosts
        this shell never claimed one; the grouping was a rendering, not a
        promise. Sorting by the clock an entry carries is a different
        thing, needs the whole answer in hand, and is
        `docs/plans/logline-order.md`.

        Attribution moves onto the LINE, where it has to be once the hosts
        are mixed. With one host there is nothing to say and the output is
        what it always was."""
        q, ends = queue.Queue(), {}
        framed = kind != "loglines"

        def reader(host):
            # ⚠ The sentinel goes out whatever happens. The drain below
            # counts them to know when every host is finished, so a reader
            # that raised without one would hang the shell for good.
            try:
                ends[host] = self.ask_stream(
                    doc, host, lambda r: q.put((host, r)), framed=framed)
            except Exception as e:                        # noqa: BLE001
                ends[host] = (str(e), 127)
            finally:
                q.put((host, None))

        for host in TARGETS:
            threading.Thread(target=reader, args=(host,), daemon=True).start()

        # The host goes in a column of its own, one width for all of them,
        # so the store names still line up once the hosts are mixed.
        hw = max(len(label(h)) for h in TARGETS) if len(TARGETS) > 1 else 0
        pre = {h: f"  {label(h):{hw}}  " if hw else "  " for h in TARGETS}
        paths = {h: self.paths_on(h) for h in TARGETS} if not framed else {}
        left, shown, more, dropped = len(TARGETS), 0, False, 0
        while left:
            host, rec = q.get()
            if rec is None:
                left -= 1
                err, rc = ends.get(host, ("", 0))
                if rc != 0:
                    bad[host] = err or f"exit {rc}"
                continue
            k, f, payload = rec
            if k == "source":
                self.names[f.get("id", "?")] = os.path.basename(f.get("path", "?"))
            elif k == "position" and f.get("id"):
                # Positions MERGE onto what is held: every store EXAMINED
                # reports one, and a store that delivered nothing reports
                # the offset it was RESUMED from.
                if "offset" in f:
                    at[f["id"]] = {"id": f["id"], "offset": int(f["offset"])}
                else:
                    at.setdefault(f["id"], {"id": f["id"]})
            elif k == "stream-end":
                more = more or f.get("status") == "limited"
            elif k in ("entry", "line"):
                if room is not None and shown >= room:
                    dropped += 1          # read before the bound was reached
                    continue
                if k == "entry":
                    self.show_entry(pre[host], f, payload)
                else:
                    self.show_line(pre[host], paths[host], payload)
                shown += 1
                shown_by[host] = shown_by.get(host, 0) + 1
        return shown, more, dropped

    def show_entry(self, pre, f, payload):
        """One entry, its store named in the column every kind uses. A
        multi-line entry is one entry: the continuation lines are indented
        to sit under the first, never re-labelled."""
        who = self.names.get(f.get("id", ""), "")
        body = (payload or b"").decode("utf-8", "replace").rstrip("\n")
        for i, line in enumerate(body.split("\n")):
            print(f"{pre}{who:28} {line}" if i == 0 else f"{pre}{'':28} {line}")

    def show_line(self, pre, by_path, payload):
        """One `loglines` line. timberfs prefixes each with the store's
        PATH, which on a fleet is most of the terminal and none of the
        information — rewrite it to the store's name, in the column
        `records` uses, so the two kinds read the same way.

        Split on the FIRST colon and look the prefix up: a path that is not
        a store we know about is left exactly as it came, because guessing
        at the shape of a line is how a log line containing a colon becomes
        a truncated one."""
        line = payload.decode("utf-8", "replace")
        head, sep, rest = line.partition(":")
        if sep and head in by_path:
            print(f"{pre}{by_path[head]:28} {rest}")
        else:
            print(f"{pre}{line}" if line else "")

    def once_raw(self, doc):
        """`chunks`: the answer is compressed frames, written through as
        BYTES.

        ⚠ Not decoded. This path used to go through the text transport,
        which decodes utf-8 with replacement — so every frame reaching a
        terminal had already been corrupted, silently, in the one kind
        whose whole promise is that nothing is decompressed or altered at
        either end."""
        bad = {}
        for host in TARGETS:
            out, err, rc = self.ask(doc, host, raw=True)
            if rc != 0:
                bad[host] = err or f"exit {rc}"
                continue
            sys.stdout.buffer.write(out)
        sys.stdout.buffer.flush()
        report_errors(bad)

    def list_stores(self, doc):
        """One listing from every host, in parallel: a set has no order to
        preserve, so nothing is gained by waiting for them in turn."""
        got, bad, lock = [], {}, threading.Lock()

        def one(host):
            out, err, rc = self.ask(doc, host)
            with lock:
                if rc != 0:
                    bad[host] = err or f"exit {rc}"
                    return
                try:
                    stores, ver = unwrap(out)
                except json.JSONDecodeError as e:
                    bad[host] = f"not JSON: {e}"
                    return
                self.hosts.setdefault(host, {})["version"] = ver
                for st in stores:
                    st["_host"] = host
                got.extend(stores)

        ts = [threading.Thread(target=one, args=(h,)) for h in TARGETS]
        for t in ts:
            t.start()
        for t in ts:
            t.join()
        show_stores(got, unreachable=bad)

    def tail(self, doc):
        """Follow the end of the tape. NO CLOCK IS INVOLVED.

        Joining a store means asking where its tape ends and resuming
        there; every answer after that says where it got to, and that
        place is what the next poll carries. Each store keeps its own.

        ⚠ Never bound this by time. A window on the logline clock made
        one store's stamps decide where every store was read from next,
        and a store stamped ahead of the wall clock then silenced the
        whole fleet until the clock caught up.

        The opening read reaches the live edge — an entry there is in no
        chunk yet and says so, but it still says where it sits, so the
        burst is followed past. The POLLS are served out of flushed
        chunks, so after that entries appear a flush behind the writer.
        """
        if (doc.get("match") or {}).get("granularity") == "chunks":
            raise ValueError(
                "`chunk may have` names whole chunks out of the token index, "
                "which has nothing to skip on a read that is following the "
                "end of the tape.\n     Ask `entry has ...` to filter the "
                "entries as they arrive.")
        window = doc.get("window") or {}
        if window.get("from") is not None or window.get("to") is not None:
            raise ValueError(
                "a tail follows the END OF THE TAPE, which is a place and not "
                "a time, so it takes no time bound"
                + (" — and this session is one" if self.session else "")
                + ".\n     Drop the `since`/`until`"
                + (" or the session (`drop session;`)" if self.session else "")
                + ", or ask `select` for a window.")
        # `limit N` on a tail is how much to OPEN with, which is what
        # `tail -n` means; `max` would instead cap every poll for ever.
        bound = doc.pop("max", None) or {"entries": BURST}
        doc = dict(doc, response_format={"kind": "records"})
        doc.pop("window", None)
        print("  tailing (ctrl-c to stop).")
        at, complained, opened = {}, {}, set()
        try:
            while True:
                more = False
                for host in TARGETS:
                    # PER HOST. One that was down at the start, or added
                    # since, has no position — and with no window either, a
                    # cursorless read is the whole store.
                    if host not in opened:
                        err = self.tail_join(host, doc, bound, at)
                    else:
                        out, err, rc = self.ask(
                            dict(doc, cursor=list(at.values())) if at else doc,
                            host)
                        if rc == 0:
                            self.show_tail(out, host)
                            more |= self.next_page(out, at)
                    if err:
                        # Said once per host per outage, not once per poll.
                        if complained.get(host) != err:
                            print(f"  ⚠ {label(host)}: {fmt_err(err)}")
                            complained[host] = err
                        # NOT un-opened: its positions are still held, so a
                        # blip resumes where it left off. Re-joining would
                        # take up the tape's END and skip the outage.
                        continue
                    complained.pop(host, None)
                    opened.add(host)
                # A bound stopped one of them: there is already more than
                # one answer's worth waiting, so ask again now.
                if not more:
                    time.sleep(2)
        except KeyboardInterrupt:
            print("\n  stopped.")

    def tail_join(self, host, doc, bound, at):
        """Take up a host's stores at the end of their tapes, and show the
        last few entries of each. Returns what went wrong, or None.

        The two reads are in this order for a reason: the LISTING fixes
        where each store had got to, and the burst is then shown only up
        to that point. An entry written between the two arrives on the
        first poll instead — printed once, from one side or the other,
        which the other order cannot promise.

        ⚠ A tail answer names no store: it carries no `source` record,
        and an entry carries an `id` only where the answer holds several.
        So the ENDS are what attribute it — the listing is not an
        optimisation here, it is where the identity comes from."""
        probe = {k: v for k, v in doc.items() if k in ("v", "stores")}
        probe["response_format"] = {"kind": "stores"}
        out, err, rc = self.ask(probe, host)
        if rc != 0:
            return err or f"exit {rc}"
        try:
            stores, _ = unwrap(out)
        except ValueError as e:
            return str(e)
        ends = {}
        for s in stores:
            if not s.get("id"):
                continue
            # Where the tape ENDS: what has left the store plus what it
            # still holds, which retention moves together.
            ends[s["id"]] = (s.get("dropped_uncompressed_bytes", 0)
                             + s.get("logical_bytes", 0))
            self.names[s["id"]] = os.path.basename(s.get("path", "?"))
            at[s["id"]] = {"id": s["id"], "offset": ends[s["id"]]}
        if not ends:
            return None
        out, err, rc = self.ask(dict(doc, tail=bound), host)
        if rc != 0:
            return err or f"exit {rc}"
        self.show_tail(out, host, bound, ends)
        # Past the last entry SHOWN, which reaches further than the
        # listing did when the burst ran into the live edge: an entry
        # there is in no chunk yet and says so, but it still says where.
        self.tail_positions(out, at, ends)
        return None

    def show_tail(self, out, host, trim=None, whose=None):
        """The entries in one answer, attributed and printed.

        `trim` keeps the last N of each store — the server delivers ABOUT
        the last N, starting at a chunk boundary, and on a store with 256
        KiB chunks about-twenty is hundreds of lines."""
        ids, by_store = [], {}
        for kind, f, payload in records(out):
            if kind == "source":
                self.names[f.get("id", "?")] = os.path.basename(
                    f.get("path", "?"))
                ids.append(f.get("id", ""))
            elif kind == "entry":
                by_store.setdefault(which(f, ids, whose), []).append(payload)
        n = (trim or {}).get("entries")
        for sid, payloads in by_store.items():
            who = self.names.get(sid, "")
            where = f"{label(host)} " if len(TARGETS) > 1 else ""
            for payload in (payloads[-n:] if n else payloads):
                print(f"  {where}{who:28} {(payload or '').rstrip()}")

    def tail_positions(self, out, at, whose=None):
        """Where a tail answer got to, which it does not say outright.

        Every entry states the offset it sits at and the length it runs
        for, so just past the last one is where to resume — the same
        number a windowed answer reports as its `position`. That holds at
        the live edge too: an entry there is in no chunk yet and says so
        by leaving `chunk` out, but the tape is bytes and it still says
        which ones."""
        ids = []
        for kind, f, _ in records(out):
            if kind == "source":
                ids.append(f.get("id", ""))
            elif kind == "entry" and "offset" in f and "len" in f:
                sid = which(f, ids, whose)
                end = int(f["offset"]) + int(f["len"])
                if end > at.get(sid, {}).get("offset", -1):
                    at[sid] = {"id": sid, "offset": end}


def load_history(path, size):
    """Read the history, and arrange for it to be written back.

    ⚠ Mode 0600, and created that way rather than fixed afterwards. A
    history of queries is a list of the identifiers someone went looking
    for — request ids, customer names, hostnames — which is production
    data sitting in a dotfile. `psql` has the same exposure and the same
    answer.

    Failure here never stops a session. A read-only home, a directory that
    does not exist, a file someone else owns: none of that is a reason to
    refuse to open a shell, so it is reported once and the session runs
    without history."""
    readline.set_history_length(size)
    try:
        readline.read_history_file(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        print(f"  ! history not read from {path}: {e}")

    def save():
        try:
            # Create it 0600 rather than widening then narrowing: between
            # those two calls the file is readable, and that window is the
            # whole point of the mode.
            fd = os.open(path, os.O_CREAT | os.O_WRONLY, 0o600)
            os.close(fd)
            readline.write_history_file(path)
        except OSError as e:
            print(f"  ! history not saved to {path}: {e}")

    return save


def remember(line):
    """Record a line, whether or not readline saw it.

    In a terminal readline adds it as `input()` returns; through a pipe it
    does not, because `input()` only uses readline on a tty. Adding it here
    makes the history the same either way — and comparing against the last
    entry is what stops a terminal getting two copies of every line."""
    n = readline.get_current_history_length()
    if n and readline.get_history_item(n) == line:
        return
    readline.add_history(line)


def parse_args(argv):
    ap = argparse.ArgumentParser(
        prog="timbersh", add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="timbersh — an interactive shell for timberfs. "
                    "EXPERIMENTAL: the grammar is not promised.",
        epilog="Every option defaults to the environment variable beside it, so\n"
               "a flag overrides an export for one session and nothing else.\n"
               "\n"
               "WHERE THE FLEET IS, most explicit first: --resolver, --targets\n"
               "or --cmd/--hosts (one of them, not two); then $TIMBERFS_RESOLVER,\n"
               "$TIMBERFS_TARGETS, $TIMBERFS_CMD/$TIMBERFS_HOSTS; then\n"
               "~/.config/timberfs/targets.json, /etc/timberfs/targets.json; then\n"
               "one local `timberfs query --query -`. `show hosts;` says which won.\n"
               "\n"
               "Inside the shell, `\\?` prints the statement syntax.")
    ap.add_argument("--resolver", metavar="CMD|URL",
                    help="a command that prints the fleet as a target "
                         "document, or a url to GET it from — told apart by "
                         "the url's scheme. $TIMBERFS_RESOLVER")
    ap.add_argument("--targets", metavar="FILE",
                    help="the same document, from a file. $TIMBERFS_TARGETS; "
                         "else ~/.config/timberfs/targets.json, else "
                         "/etc/timberfs/targets.json")
    ap.add_argument("--cmd", metavar="ARGV",
                    help="one command reaching every host, with "
                         f"{HOST_TOKEN} substituted per --hosts. Default "
                         "`timberfs query --query -`. $TIMBERFS_CMD")
    ap.add_argument("--hosts", metavar="H,H",
                    help="the hosts that command reaches. $TIMBERFS_HOSTS")
    ap.add_argument("--refresh", metavar="CMD|URL",
                    help="how `refresh` re-derives the fleet, where that is "
                         "not how it was produced — a command, or a url to "
                         "GET it from. $TIMBERFS_REFRESH; else the "
                         "document's `refresh`; else whatever produced the "
                         "fleet")
    ap.add_argument("--rc", metavar="FILE", default=RC,
                    help="statements run at startup. $TIMBERSH_RC")
    ap.add_argument("--page", metavar="N", type=int, default=PAGE,
                    help="entries per CALL on an unbounded read, default "
                         "10000. Not the statement's `limit` — that is how "
                         "much of the ANSWER you want, this is how much of "
                         "it is in memory at once. $TIMBERSH_PAGE")
    ap.add_argument("--ttl", metavar="SECS", type=float,
                    default=float(os.environ.get("TIMBERSH_STORE_TTL", "0")),
                    help="expire the cached store list after SECS. Default 0, "
                         "which never expires it — `refresh` re-reads it. "
                         "$TIMBERSH_STORE_TTL")
    ap.add_argument("--histfile", metavar="FILE", default=HISTFILE,
                    help="where the line history is kept, mode 0600. "
                         "$TIMBERSH_HISTFILE")
    ap.add_argument("--histsize", metavar="N", type=int, default=HISTSIZE,
                    help="how many lines to keep. $TIMBERSH_HISTSIZE")
    ap.add_argument("-q", "--quiet", action="store_true",
                    help="start without printing the help")
    return ap.parse_args(argv)


def main(argv=None):
    global FLEET, TARGETS, RC, STORE_TTL, PAGE
    a = parse_args(argv)
    RC, STORE_TTL = a.rc, a.ttl
    if a.page < 1:
        sys.exit("timbersh: --page wants a positive number of entries")
    PAGE = a.page
    try:
        FLEET = timberfs_client.resolve(a.resolver, a.targets, a.cmd, a.hosts,
                                        a.refresh)
    except ValueError as e:
        sys.exit(f"timbersh: {e}")
    TARGETS = FLEET.names
    sh = Shell()
    # A space is the only delimiter: `[type=console` is ONE word to the
    # completer, which is what lets a predicate literal complete its own
    # keys and values.
    readline.set_completer(Complete(sh))
    readline.set_completer_delims(" ")
    readline.parse_and_bind("tab: complete")
    save_history = load_history(a.histfile, a.histsize)
    if not a.quiet:
        print(HELP)
        if len(TARGETS) > 1:
            print(f"  {len(TARGETS)} hosts from {FLEET.source}: "
                  f"{', '.join(label(h) for h in TARGETS)}\n")
    # Named on the way in, not discovered as a gap in an answer.
    for name, why in FLEET.unusable:
        print(f"  ⚠ {label(name)} was not asked: {why}")
    if sh.views:
        print(f"  {len(sh.views)} logview(s) from {RC}: {', '.join(sorted(sh.views))}")
    # Whatever ends the session — `\\q`, EOF, an interrupt, a statement
    # that raised — the history is written. An exit path that skipped it
    # would lose exactly the session someone wants back.
    try:
        while True:
            try:
                line = input("\ntimberfs=# ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return
            if not line:
                continue
            remember(line)
            try:
                sh.do(line)
            except SystemExit:
                return
            except Exception as e:
                print(f"  ! {e}")
    finally:
        save_history()


if __name__ == "__main__":
    main()
