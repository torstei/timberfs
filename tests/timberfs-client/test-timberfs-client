@test
def a_resolver_is_asked_one_question_and_gets_no_arguments():
    """"What is the fleet". "Who has this store" has not been thought
    through, and passing an argument now would design it by accident."""
    with tmp() as d, env():
        r = script(d, "r", 'printf \'{"v": "%s", "targets": [{"name": "%s",'
                           ' "cmd": ["x"]}]}\' "$V" "argv=$*"'
                           .replace("$V", V))
        assert fc.resolve(resolver=r).names == ["argv="], \
            fc.resolve(resolver=r).names


@test
def refresh_re_resolves_rather_than_remembering():
    """A resolver DERIVES its answer, so asking again is how a fleet
    that changed becomes visible."""
    with tmp() as d, env():
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]}))
        r = script(d, "r", f"cat {f}")
        fleet = fc.resolve(resolver=r)
        assert fleet.names == ["one"]
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]},
                               {"name": "two", "cmd": ["y"]}))
        assert fleet.again().names == ["one", "two"]


# ------------------------------------------------------- url as a target
@test
def a_url_target_and_a_cmd_target_are_one_fleet():
    """The whole point again, one transport further out: an ssh, a site
    wrapper and an HTTP endpoint sit in the same list and none has to be
    expressible as the others."""
    targets, unusable, _ = fc.parse(doc(
        {"name": "mail01", "cmd": ["ssh", "mail01", "timberfs"]},
        {"name": "db01", "url": "http://db01:9099/query"},
        {"name": "local", "url": "unix+http:///run/timberfs.sock//query"}),
        "test")
    assert unusable == []
    assert [t.name for t in targets] == ["mail01", "db01", "local"]
    assert targets[0].via == "ssh mail01 timberfs"
    assert targets[1].via == "POST http://db01:9099/query"
    assert targets[2].via == "POST unix+http:///run/timberfs.sock//query"
    assert targets[2].socket == "/run/timberfs.sock"


@test
def the_socket_and_the_request_path_split_at_the_first_double_slash():
    """`//` is the boundary because it cannot MEAN anything inside a
    filesystem path — POSIX collapses repeated slashes — so it can never
    cut a path in half. A `:` or a `#` CAN be part of a socket path, and
    one holding such a separator would split in the wrong place with
    nothing to say it had.

    Absent, the request path is `/`. The FIRST one decides, so later ones
    stay in the request path, where HTTP allows them."""
    for url, want in (
            ("unix+http:///run/timberfs.sock//query",
             ("/run/timberfs.sock", "localhost", "/query")),
            ("unix+http:///run/timberfs.sock",
             ("/run/timberfs.sock", "localhost", "/")),
            ("unix+http:///run/odd:name%231/x.sock//a//b",
             ("/run/odd:name#1/x.sock", "localhost", "/a//b")),
            # %2F%2F decodes to // AFTER the split, so even the
            # pathological socket path has a way to be written.
            ("unix+http:///run/a%2F%2Fb.sock//query",
             ("/run/a//b.sock", "localhost", "/query")),
            ("unix+http:///run/x.sock//query?deep=1",
             ("/run/x.sock", "localhost", "/query?deep=1"))):
        assert fc.split_url(url) == want, (url, fc.split_url(url))


@test
def the_host_is_optional_and_is_never_the_thing_dialled():
    """It is the `Host:` header, which is what a server routing several
    names off ONE socket reads. The socket is what gets dialled, so a
    name here can never send the request somewhere else."""
    assert fc.split_url("unix+http://logs.internal/run/x.sock//q") == (
        "/run/x.sock", "logs.internal", "/q")
    assert fc.split_url("unix+http:///run/x.sock//q")[1] == "localhost"


@test
def the_requests_unixsocket_spelling_is_answered_by_name():
    """`http+unix://` is the name most people reach for, and it means
    something else — the socket percent-encoded in the authority, which
    has nowhere to put a Host. Reusing it for a different grammar is the
    trap; listing our schemes at someone who typed the one every Python
    client on the machine speaks is not an answer."""
    try:
        fc.split_url("http+unix://%2Frun%2Fx.sock/query")
        raise AssertionError("accepted the other grammar")
    except ValueError as e:
        assert "requests-unixsocket" in str(e), str(e)
        assert "unix+http://" in str(e), str(e)


@test
def a_url_that_names_no_socket_or_no_host_is_named_not_dropped():
    """Each scheme is missing a different half: an `http://` with no
    authority has nowhere to connect to, and a `unix+http://` whose path
    is only the host has no socket in it."""
    targets, unusable, _ = fc.parse(doc(
        {"name": "a", "cmd": ["x"]},
        {"name": "b", "url": "http:///query"},
        {"name": "c", "url": "unix+http://logs.internal"}), "test")
    assert [t.name for t in targets] == ["a"]
    assert "names no host" in unusable[0][1], unusable
    assert "names no socket" in unusable[1][1], unusable


@test
def two_transports_on_one_target_is_a_mistake_in_the_document():
    """Not a target this build cannot reach — a target that says two
    things. Preferring one silently is exactly the error the target list
    exists to remove, so it is named."""
    for bad, want in (
            ({"name": "h", "cmd": ["x"], "url": "http://h/q"},
             "both `cmd` and `url`"),
            ({"name": "h", "url": ""}, "non-empty string")):
        try:
            fc.parse(doc(bad), "test")
            raise AssertionError(f"accepted {bad!r}")
        except ValueError as e:
            assert want in str(e), f"{bad!r} -> {e}"


@test
def a_member_this_build_does_not_read_is_not_quietly_ignored():
    """It may be the member that says HOW to reach the target — a
    credential, a socket, a timeout — and a target reached the wrong way
    is worse than one not reached at all. So the target is named, and the
    rest of the fleet still answers."""
    targets, unusable, _ = fc.parse(doc(
        {"name": "a", "cmd": ["x"]},
        {"name": "b", "url": "http://logs.internal/query",
         "socket": "/run/x.sock"}), "test")
    assert [t.name for t in targets] == ["a"]
    assert "declares socket" in unusable[0][1], unusable


# --------------------------------------------------------- over the wire
@test
def a_url_target_posts_the_document_and_streams_the_answer():
    """The document goes up as the body, the answer comes back as the
    body, and the URL's own host is the Host header — which is what a
    server routing several names off one socket reads."""
    seen = Seen()
    seen.reply = b"the-answer"
    with tcp_server(seen) as base:
        t = fc.Target("h", url=base + "/query?deep=1")
        out, err, rc = t.run(b'{"v":"x"}')
        assert (out, err, rc) == (b"the-answer", "", 0), (out, err, rc)
        assert seen.method == "POST" and seen.path == "/query?deep=1"
        assert seen.body == b'{"v":"x"}', seen.body
        assert seen.host == base[len("http://"):], seen.host


@test
def a_url_answer_is_read_as_it_arrives_not_when_it_ends():
    """The same property the process transport has, and the reason one
    loop serves both: the fastest host's first line must not wait for the
    slowest host's last one."""
    seen = Seen()
    seen.reply, seen.hold = b"first-piece", threading.Event()
    with tcp_server(seen) as base:
        call = fc.Target("h", url=base + "/query").open(b"{}")
        got = call.read1(65536)
        assert got == b"first-piece", got   # arrived; the server is still in it
        seen.hold.set()
        rest = b""
        while True:
            chunk = call.read1(65536)
            if not chunk:
                break
            rest += chunk
        assert rest == b"-and-the-rest", rest
        assert call.finish() == ("", 0)


@test
def a_unix_socket_is_dialled_instead_of_the_host():
    """The case the separate member exists for. Everything else about the
    request is ordinary HTTP."""
    seen = Seen()
    seen.reply = b"over-the-socket"
    with tmp() as d:
        sock = os.path.join(d, "timberfs.sock")
        with unix_server(seen, sock):
            t = fc.Target("h", url=f"unix+http://timberfs.local{sock}//query")
            out, err, rc = t.run(b"{}")
            assert (out, err, rc) == (b"over-the-socket", "", 0), (out, err, rc)
            assert seen.path == "/query", seen.path
            assert seen.host == "timberfs.local", seen.host


@test
def a_failed_request_carries_the_reason_from_the_body():
    """A url target has no stderr, so the body IS the explanation — and a
    non-2xx must not be streamed as an answer, or a proxy's error page
    parses as records that happen to be unreadable."""
    seen = Seen()
    seen.status, seen.reply = 400, b"the query document was refused: no such member `qq`"
    with tcp_server(seen) as base:
        out, err, rc = fc.Target("h", url=base + "/query").run(b"{}")
        assert out == b"", out
        assert rc == 1 and "HTTP 400" in err and "no such member" in err, (rc, err)


@test
def nothing_listening_is_that_target_failing_not_the_fleet():
    """Something in the system being down must not stop the logs that
    ARE available being read, so a transport that never started is a
    non-zero rc with its own words — the same shape as ssh refusing."""
    with tmp() as d:
        out, err, rc = fc.Target(
            "h", url=f"unix+http://{d}/not-there.sock//query").run(b"{}")
        assert (out, rc) == (b"", 127), (out, rc)
        assert "not-there.sock" in err, err
    out, err, rc = fc.Target("h", url="http://127.0.0.1:1/query").run(b"{}")
    assert (out, rc) == (b"", 127), (out, rc)
    assert err, err


# --------------------------------------------------------------- refresh
@test
def refresh_may_be_a_different_command_from_the_one_that_resolved():
    """Getting the fleet and re-asking for it are allowed to cost
    different amounts — a full sweep to open a session with, a cheap one
    to re-ask — so they are allowed to be different commands."""
    with tmp() as d, env():
        full = script(d, "full", f"cat {d}/full.json")
        cheap = script(d, "cheap", f"cat {d}/cheap.json")
        open(f"{d}/full.json", "w").write(doc({"name": "one", "cmd": ["x"]}))
        open(f"{d}/cheap.json", "w").write(doc({"name": "one", "cmd": ["x"]},
                                               {"name": "two", "cmd": ["y"]}))
        fleet = fc.resolve(resolver=full, refresh=cheap)
        assert fleet.names == ["one"]
        assert fleet.refresh_source == "--refresh"
        again = fleet.again()
        assert again.names == ["one", "two"], again.names
        # And it keeps asking the refresh command, not the resolver.
        assert again.again().names == ["one", "two"]


@test
def a_document_can_name_the_command_that_re_derives_it():
    """So a --targets file and /etc/timberfs/targets.json gain a refresh
    too — the answer travels with the fleet it describes, rather than
    having to be typed beside it."""
    with tmp() as d, env():
        open(f"{d}/next.json", "w").write(doc({"name": "two", "cmd": ["y"]}))
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]},
                               refresh=["cat", f"{d}/next.json"]))
        fleet = fc.resolve(targets=f)
        assert fleet.names == ["one"]
        assert "the `refresh` in --targets" == fleet.refresh_source
        assert fleet.again().names == ["two"]


@test
def the_refresh_in_force_is_the_most_explicit_one():
    """Same flag-beats-export precedence as everywhere else here, with the
    document last — it is the fleet's own default and the least explicit
    thing in the room."""
    with tmp() as d, env():
        for who in ("flag", "export", "in-doc"):
            open(f"{d}/{who}.json", "w").write(
                doc({"name": who, "cmd": ["x"]}))
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]},
                               refresh=["cat", f"{d}/in-doc.json"]))
        assert fc.resolve(targets=f).again().names == ["in-doc"]
        os.environ["TIMBERFS_REFRESH"] = f"cat {d}/export.json"
        assert fc.resolve(targets=f).again().names == ["export"]
        assert fc.resolve(targets=f,
                          refresh=f"cat {d}/flag.json").again().names == ["flag"]


@test
def with_no_refresh_named_it_re_runs_what_produced_the_fleet():
    """The behaviour that was there before, unchanged — and what a
    refreshed document naming no `refresh` of its own falls back to."""
    with tmp() as d, env():
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]}))
        r = script(d, "r", f"cat {f}")
        fleet = fc.resolve(resolver=r)
        assert fleet.refresh is None
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]},
                               {"name": "two", "cmd": ["y"]}))
        assert fleet.again().names == ["one", "two"]


@test
def a_refresh_named_with_no_command_in_it_is_a_mistake():
    """Naming it says the two commands are not the same, so an empty one
    silently falling back to the resolver would be the opposite of what
    was asked for."""
    with tmp() as d, env():
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]}))
        try:
            fc.resolve(targets=f, refresh="   ")
            raise AssertionError("accepted an empty --refresh")
        except ValueError as e:
            assert "names no command" in str(e), str(e)


@test
def a_refresh_that_failed_is_fatal_like_a_resolver_that_failed():
    """It answers the same question, so being wrong about it is wrong in
    the same way: the fleet after it would not be the fleet."""
    with tmp() as d, env():
        f = os.path.join(d, "t.json")
        open(f, "w").write(doc({"name": "one", "cmd": ["x"]}))
        bad = script(d, "bad", "echo 'the sweep found nothing' >&2; exit 4")
        fleet = fc.resolve(targets=f, refresh=bad)
        try:
            fleet.again()
            raise AssertionError("survived a failing refresh")
        except ValueError as e:
            assert "exit 4" in str(e) and "found nothing" in str(e), str(e)


@test
def a_malformed_refresh_member_is_named_like_a_malformed_cmd():
    for bad in ("fleet-sweep --cached", [], ["sweep", 3]):
        try:
            fc.parse(doc({"name": "h", "cmd": ["x"]}, refresh=bad), "test")
            raise AssertionError(f"accepted refresh {bad!r}")
        except ValueError as e:
            assert "non-empty list of strings" in str(e), str(e)


def main():
    want = sys.argv[1] if len(sys.argv) > 1 else ""
    chosen = [t for t in TESTS if want in t.__name__]
    failed = 0
    for t in chosen:
        try:
            t()
            print(f"  ok    {t.__name__}")
        except AssertionError as e:
            failed += 1
            print(f"  FAIL  {t.__name__}\n        {e}")
        except Exception as e:
            failed += 1
            print(f"  ERROR {t.__name__}\n        {type(e).__name__}: {e}")
    print(f"\n{len(chosen) - failed}/{len(chosen)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
