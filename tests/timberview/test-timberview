# -------------------------------------------------------------- search
@test
def a_hit_is_a_coordinate_and_opening_it_is_a_seek():
    """A hit on a chunk's FIRST line is the case that catches a viewer
    reading ahead: that line is the one the run holds back as a possible
    fragment, so landing on it would show the next line and report the
    wrong offset. The chunk before it is fetched rather than left to the
    read-ahead."""
    f = Fake(["one\ntwo\n", "three\nfour\n"])
    f.hits = [tv.Hit(tv.Address(ID_A, None, "offset", 8), f.store, "three")]
    v = opened(f)
    v.search("three")
    assert len(v.hits) == 1, v.message
    v.jump(v.hits[0])
    assert v.line().text == "three", v.line().text
    assert str(v.address()) == f"timber:{ID_A}#offset=8"


@test
def a_hit_in_another_store_switches_to_it():
    """A search knows nothing about which log holds the identifier, so
    following one has to be able to leave the store you opened."""
    other = Fake(["hello\nworld\n"], sid=ID_B, host="mail01")
    other.store["name"] = "mail"
    f = Fake(["one\n"], others=[other.store])
    f.chunk = other.chunk
    f.hits = [tv.Hit(tv.Address(ID_B, "mail01", "offset", 6),
                     other.store, "world")]
    v = opened(f)
    v.search("world")
    v.jump(v.hits[0])
    assert v.store["id"] == ID_B and v.line().text == "world"
    assert str(v.address()) == f"timber://mail01/{ID_B}#offset=6"


@test
def a_pair_with_no_identity_is_refused_before_anything_is_read():
    """A plain `append` leaves a pair with no manifest, which is not a
    store: there is no id, so no place in it can be written down. Said
    in timberfs's own words rather than crashing on the missing field."""
    f = Fake(["a\n"])
    del f.store["id"]
    v = tv.View(f, f.store)
    try:
        v.open()
        raise AssertionError("opened a pair with no identity")
    except tv.Refused as e:
        assert "identity --mint" in str(e), str(e)
    assert f.fetches == 0, f.fetches


@test
def an_answer_that_stopped_at_a_bound_says_so():
    """A capped search and an exhausted one are different answers, and
    only one of them means "that is all of them"."""
    f = Fake(["one\n"])
    f.hits = [tv.Hit(tv.Address(ID_A, None, "offset", 0), f.store, "one")]
    f.capped = True
    f.unplaced = 2
    v = opened(f)
    v.search("one")
    assert "stopped at a bound" in v.message, v.message
    assert "2 not in a chunk yet" in v.message, v.message


@test
def a_target_that_did_not_answer_is_not_an_empty_fleet():
    """One machine being down must not stop you reading the logs that
    ARE there — and when it stops everything, "nothing was listed" and
