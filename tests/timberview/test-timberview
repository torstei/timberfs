@test
def a_chunk_is_cached_because_its_bytes_never_change():
    """A chunk is immutable once written, which is what makes reading it
    twice a waste rather than a risk."""
    live = {None: {"name": "app", "id": ID_A, "chunks": 3, "first_seq": 0,
                   "last_seq": 2, "logical_bytes": 30, "dropped_chunks": 0,
                   "dropped_uncompressed_bytes": 0, "labels": {}}}
    seen = []

    def ask(doc, host=None, raw=False):
        kind = (doc.get("response_format") or {}).get("kind")
        if kind == "stores":
            return json.dumps({"server_version": "t", "stores": [live[None]]}), "", 0
        seen.append(doc["window"].get("from_chunk"))
        body = b"a line\n"
        return wire(("chunk", {"len": len(_z(body)), "chunk": 1,
                               "uncomp_start": 0, "uncomp_len": len(body),
                               "wf": 1, "wl": 2}, _z(body))), "", 0

    b = tv.QueryBackend(ask, [None])
    assert b.chunk(live[None], seq=1).seq == 1
    assert b.chunk(live[None], seq=1).seq == 1
    assert seen == [1], seen


@test
def the_neighbours_are_read_ahead_so_the_scroll_is_local():
    """One chunk is ten screenfuls, so the reader is looking at this one
    for a while — which is exactly when to fetch the next. Opening waits
    for ONE round trip; the scroll that needs the neighbour finds it."""
    f = Fake(["a\n" * 8, "b\n" * 8, "c\n" * 8])
    asked = []
    f.prefetch = lambda store, *seqs: asked.extend(seqs)
    v = opened(f)                       # the live end, where a pager opens
    assert len(v.tape.chunks) == 1, v.tape.chunks
    assert asked == [1], asked


@test
def every_target_is_asked_at_once():
    """Four hosts one after another is four latencies for one answer.
    Counted rather than timed: the claim is that they overlap."""
    inflight, peak, lock = [0], [0], threading.Lock()

    def ask(doc, host=None, raw=False):
        with lock:
            inflight[0] += 1
            peak[0] = max(peak[0], inflight[0])
        time.sleep(0.05)
        with lock:
            inflight[0] -= 1
        return json.dumps({"server_version": "t", "stores": []}), "", 0

    b = tv.QueryBackend(ask, ["a", "b", "c", "d"])
    b.stores()
    assert peak[0] == 4, f"peak concurrency {peak[0]}, so they went in turn"


@test
def bounds_just_read_are_not_read_again():
    """Retention moves the floor while you read, so the numbers cannot be
    remembered from when the store was opened — but re-reading them in
    front of a chunk that is already cached puts a whole round trip
    where none is needed."""
    f = Fake(["a\n" * 4, "b\n" * 4])
    f.store["_read_at"] = time.monotonic()
    f.FRESH = 10.0
    reads = []
    real = f.bounds
    f.bounds = lambda st: (reads.append(1), real(st))[1]
    t = tv.Tape(f, f.store)
    t.refresh()
    assert reads == [], "re-read bounds that had just been read"
    f.store["_read_at"] = time.monotonic() - 60
    t.refresh()
    assert reads == [1], "never re-read bounds that had gone stale"


@test
def a_wait_says_so_and_hands_back_what_it_waited_for():
    """A screen that stops answering is indistinguishable from one that
    has hung, which is what a fleet-latency pager looks like without
    this."""
    scr = Screenish()
    screen = Screen_for_test()
    assert screen.busy(scr, "reading mail01", lambda: (time.sleep(0.5), 7)[1]) == 7
    assert any("reading mail01" in t for t in scr.painted), scr.painted
    assert any("^C gives up" in t for t in scr.painted), scr.painted

    # A failure on the worker is the caller's failure, not a swallowed one.
    def boom():
        raise tv.Refused("mail01 did not answer")
    try:
        screen.busy(Screenish(), "reading mail01", boom)
        raise AssertionError("a failure on the worker was swallowed")
    except tv.Refused as e:
        assert "did not answer" in str(e)

    # And a fast answer draws nothing: a flash on every keystroke is its
    # own kind of noise.
    quiet = Screenish()
    assert screen.busy(quiet, "reading mail01", lambda: 3) == 3
    assert quiet.painted == [], quiet.painted


def main():
    want = sys.argv[1] if len(sys.argv) > 1 else ""
    chosen = [t for t in TESTS if want in t.__name__]
    failed = 0
    for t in chosen:
        try:
            t()
            print(f"  ok    {t.__name__}")
        except AssertionError as e:
            failed += 1
            print(f"  FAIL  {t.__name__}\n        {e}")
        except Exception as e:
            failed += 1
            print(f"  ERROR {t.__name__}\n        {type(e).__name__}: {e}")
    print(f"\n{len(chosen) - failed}/{len(chosen)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
