@test
def a_chunk_that_could_not_be_read_is_not_the_end_of_the_tape():
    """A host that goes away mid-scroll leaves the run unable to grow.
    Saying nothing makes that screen identical to the end of the log,
    which is the boundary this viewer exists to state."""
    def only_chunk_one():
        f = Fake(["a\n" * 4, "b\n" * 4, "c\n" * 4])
        v = opened(f, seq=1)
        f.fail_at = {0, 2}
        v.source.chunks = [c for c in v.source.chunks if c.seq == 1]
        v.source._rebuild()
        return f, v

    f, v = only_chunk_one()
    v.top = v.cur = 0
    assert v.source.extend_up() is False
    edges = edges_of(v)
    assert any("chunk 0 could not be read" in e for e in edges), edges
    assert not any("top of the log" in e for e in edges), edges

    f, v = only_chunk_one()
    v.cur = len(v.source.lines) - 1
    assert v.source.extend_down() is False
    edges = edges_of(v)
    assert any("chunk 2 could not be read" in e for e in edges), edges
    assert not any("end of chunk" in e for e in edges), edges


# The tests above fake the BACKEND. These fake the TRANSPORT instead, so
# they exercise the four operations themselves — which is where "one
# target being down does not stop the others" actually lives.
def wire(*records):
    out = b"\x1estream-start\x1fv=1\x1fsources=1\0"
    for kind, fields, payload in records:
        head = kind + "".join(f"\x1f{k}={v}" for k, v in fields.items())
        out += b"\x1e" + head.encode() + b"\0"
        if payload is not None:
            out += payload + b"\0"
    return out + b"\x1estream-end\x1fstatus=exhausted\0"


def transport(live, dead):
    """`ask` for a fleet where `dead` refuses and `live` answers."""
    def ask(doc, host=None, raw=False):
        if host in dead:
            return (b"" if raw else ""), "ssh: no route to host", 255
        kind = (doc.get("response_format") or {}).get("kind")
        if kind == "stores":
            return json.dumps({"server_version": "timberfs, 0.25.0",
                               "stores": [live[host]]}), "", 0
        if kind == "records":
            body = f"found on {host}".encode()
            return wire(("source", {"path": f"/l/{host}.log",
                                    "id": live[host]["id"]}, None),
                        ("entry", {"len": len(body), "ts": 1,
                                   "chunk": 0, "offset": 7}, body)), "", 0
        return b"", "", 0
    return ask


@test
def one_target_being_down_does_not_stop_the_others():
    """Something in the system being down must not prevent reading the
    logs that ARE available. The dead target is named — in the listing,
    in the search, and in the store picker's title — and never dropped,
    because a host that was not asked must not read as one that had
    nothing."""
    live = {"web01": {"name": "access", "id": ID_A, "chunks": 1,
                      "first_seq": 0, "last_seq": 0, "logical_bytes": 10,
                      "dropped_chunks": 0, "dropped_uncompressed_bytes": 0,
                      "path": "/l/access.log", "labels": {}}}
    b = tv.QueryBackend(transport(live, {"gone99"}), ["web01", "gone99"])
    stores = b.stores()
    assert [s["name"] for s in stores] == ["access"], stores
    assert list(b.unreachable) == ["gone99"], b.unreachable
    assert "no route to host" in b.unreachable["gone99"], b.unreachable

    hits, unplaced, capped = b.search("found")
    assert [h.address.host for h in hits] == ["web01"], hits
    assert list(b.unreachable) == ["gone99"], b.unreachable

    v = tv.View(b, stores[0])
    v.search("found")
    assert "1 hit(s)" in v.message and "not searched: gone99" in v.message, \
        v.message


@test
def a_timberfs_from_before_the_seek_is_diagnosed_not_relayed():
    """The first wall anyone meets. On its own the refusal reads as the
    caller's mistake — a chunk number with `max: {chunks: 1}` is exactly
    the legal thing — and no version check can catch it, because the
    builds either side of that change report the same version."""
    def ask(doc, host=None, raw=False):
        if (doc.get("response_format") or {}).get("kind") == "chunks":
            return b"", ("Error: a chunk number is a resume position, and "
                         "only a FOLLOWING read moves forward from one"), 1
        return json.dumps({"server_version": "timberfs, 0.25.0",
                           "stores": []}), "", 0
    b = tv.QueryBackend(ask, [None])
    try:
        b.chunk({"id": ID_A}, seq=7)
        raise AssertionError("a refusal became an answer")
    except tv.Refused as e:
        # What to DO, on the first line. Someone meeting this wants a fix
        # rather than a protocol lesson, and the mechanism read first is
        # what made the original message sound like their own mistake.
        first = str(e).splitlines()[0]
        assert first.startswith("timberfs is too old — upgrade it"), first
        assert "PATH" in str(e) and "TIMBERFS_CMD" in str(e), str(e)
        assert "report the same one" in str(e), str(e)
        # timberfs's own words are kept, and kept LAST.
        assert str(e).splitlines()[-1].startswith("      It said:"), str(e)
        assert "resume position" in str(e), str(e)


@test
def upgrading_the_other_end_is_not_something_this_machine_can_do():
    """Nothing on PATH here fixes a timberfs on another host, so the
    remedy names the target instead."""
    named = tv.too_old("mail01", "a chunk number is a resume position")
    assert named.startswith("mail01: timberfs is too old — upgrade it there")
    assert "PATH" not in named, named
    assert "`cmd`" in named, named


def _z(data):
    """A real zstd frame, so a decode that would fail on the wire fails
    here too."""
    try:
        from compression.zstd import compress
        return compress(data)
    except ImportError:
        import subprocess
        return subprocess.run(["zstd", "-q", "-c"], input=data,
                              capture_output=True).stdout


