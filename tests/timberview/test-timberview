class Screenish:
    """Enough of a curses window to draw on, and to type at."""

    def __init__(self, keys=(), width=200):
        self.painted = []
        self.keys = list(keys)
        self.exhausted = False
        self.width = width

    def getmaxyx(self):
        return (24, self.width)

    def addnstr(self, y, x, text, n, attr=0):
        self.painted.append(text)

    def erase(self):
        pass

    def chgat(self, y, x, n, attr):
        pass

    def refresh(self):
        pass

    def timeout(self, ms):
        pass

    def getch(self):
        if self.keys:
            return self.keys.pop(0)
        # Never -1 forever: a screen that keeps answering "no key" makes
        # a test that never ends, and a hanging test is worse than a
        # failing one. `q` gets out of anything.
        time.sleep(0.02)
        self.exhausted = True
        return ord("q")


@test
def a_chunk_is_cached_because_its_bytes_never_change():
    """A chunk is immutable once written, which is what makes reading it
    twice a waste rather than a risk."""
    live = {None: {"name": "app", "id": ID_A, "chunks": 3, "first_seq": 0,
                   "last_seq": 2, "logical_bytes": 30, "dropped_chunks": 0,
                   "dropped_uncompressed_bytes": 0, "labels": {}}}
    seen = []

    def ask(doc, host=None, raw=False):
        kind = (doc.get("response_format") or {}).get("kind")
        if kind == "stores":
            return json.dumps({"server_version": "t", "stores": [live[None]]}), "", 0
        seen.append(doc["window"].get("from_chunk"))
        body = b"a line\n"
        return wire(("chunk", {"len": len(_z(body)), "chunk": 1,
                               "uncomp_start": 0, "uncomp_len": len(body),
                               "wf": 1, "wl": 2}, _z(body))), "", 0

    b = tv.QueryBackend(ask, [None])
    assert b.chunk(live[None], seq=1).seq == 1
    assert b.chunk(live[None], seq=1).seq == 1
    assert seen == [1], seen


@test
def the_neighbours_are_read_ahead_so_the_scroll_is_local():
    """One chunk is ten screenfuls, so the reader is looking at this one
    for a while — which is exactly when to fetch the next. Opening waits
    for ONE round trip; the scroll that needs the neighbour finds it."""
    f = Fake(["a\n" * 8, "b\n" * 8, "c\n" * 8])
    asked = []
    f.prefetch = lambda store, *seqs: asked.extend(seqs)
    v = opened(f)                       # the live end, where a pager opens
    assert len(v.source.chunks) == 1, v.source.chunks
    assert asked == [1], asked


@test
def every_target_is_asked_at_once():
    """Four hosts one after another is four latencies for one answer.
    Counted rather than timed: the claim is that they overlap."""
    inflight, peak, lock = [0], [0], threading.Lock()

    def ask(doc, host=None, raw=False):
        with lock:
            inflight[0] += 1
            peak[0] = max(peak[0], inflight[0])
        time.sleep(0.05)
        with lock:
            inflight[0] -= 1
        return json.dumps({"server_version": "t", "stores": []}), "", 0

    b = tv.QueryBackend(ask, ["a", "b", "c", "d"])
    b.stores()
    assert peak[0] == 4, f"peak concurrency {peak[0]}, so they went in turn"


@test
def bounds_just_read_are_not_read_again():
    """Retention moves the floor while you read, so the numbers cannot be
    remembered from when the store was opened — but re-reading them in
    front of a chunk that is already cached puts a whole round trip
    where none is needed."""
    f = Fake(["a\n" * 4, "b\n" * 4])
    f.store["_read_at"] = time.monotonic()
    f.FRESH = 10.0
    reads = []
    real = f.bounds
    f.bounds = lambda st: (reads.append(1), real(st))[1]
    t = tv.Tape(f, f.store)
    t.refresh()
    assert reads == [], "re-read bounds that had just been read"
    f.store["_read_at"] = time.monotonic() - 60
    t.refresh()
    assert reads == [1], "never re-read bounds that had gone stale"


@test
def a_wait_says_so_and_hands_back_what_it_waited_for():
    """A screen that stops answering is indistinguishable from one that
    has hung, which is what a fleet-latency pager looks like without
    this."""
    scr = Screenish()
    screen = Screen_for_test()
    assert screen.busy(scr, "reading mail01", lambda: (time.sleep(0.5), 7)[1]) == 7
    assert any("reading mail01" in t for t in scr.painted), scr.painted
    assert any("^C gives up" in t for t in scr.painted), scr.painted

    # A failure on the worker is the caller's failure, not a swallowed one.
    def boom():
        raise tv.Refused("mail01 did not answer")
    try:
        screen.busy(Screenish(), "reading mail01", boom)
        raise AssertionError("a failure on the worker was swallowed")
    except tv.Refused as e:
        assert "did not answer" in str(e)

    # And a fast answer draws nothing: a flash on every keystroke is its
    # own kind of noise.
    quiet = Screenish()
    assert screen.busy(quiet, "reading mail01", lambda: 3) == 3
    assert quiet.painted == [], quiet.painted


@test
def a_hit_list_is_itself_searchable():
    """The identifier you are really after is often sitting in the
    answer to the last search. `Tab` walks the terms of the highlighted
    hit and `*` searches the picked one, without opening it first —
    `Enter` still means the primary thing here, which is going there."""
    uuid = "9da3dcf1-5a4b-4d36-b907-917daa60bd90"
    rows = [f"{'app @ mail01':28} 12:00:01 INFO req={uuid} handled"]
    screen = Screen_for_test()

    # `12:00:01` is not offered at all — every run in it is under three
    # characters. So the terms are INFO, req, the id, handled; two Tabs
    # from the first reaches the id, and `*` searches it.
    tabs = [KEY_TAB] * 2 + [ord("*")]
    what, value = screen.choose(Screenish(tabs), "t", rows,
                                searchable=True, terms_from=29)
    assert (what, value) == ("term", uuid), (what, value)

    # The store's own name is never offered: terms start at the text.
    what, value = screen.choose(Screenish([ord("*")]), "t", rows,
                                searchable=True, terms_from=29)
    assert value != "app" and "mail01" not in str(value), value

    # Enter still opens rather than searching.
    assert screen.choose(Screenish([KEY_CR]), "t", rows, searchable=True,
                         terms_from=29) == ("open", 0)
    # And a list that is not searchable has none of it.
    assert screen.choose(Screenish([ord("*"), ord("q")]), "t", rows) \
        == (None, None)


@test
def an_entry_is_one_motion_however_many_lines_it_has():
    """A stack trace is forty lines of ONE entry, and `j` walks every one
    of them. `}` and `{` step over the continuation lines to the next
    entry's start, using what the record stream said belongs together
    rather than guessing at what a continuation looks like."""
    frames = "\n".join(f"\tat frame.{i}(F.java:1)" for i in range(40))
    r = tv.Records(answer(
        ("2026-08-30T10:00:00Z INFO before", {"offset": 0}),
        (f"2026-08-30T10:00:01Z ERROR boom\n{frames}", {"offset": 100}),
        ("2026-08-30T10:00:02Z INFO after", {"offset": 900})))
    v = tv.View(Fake(["x\n"]), source=r)
    assert r.entries == 3 and len(r.lines) == 43, (r.entries, len(r.lines))

    v.cur = 0
    v.move_entry(1)
    assert v.source.lines[v.cur].text.endswith("ERROR boom"), v.source.lines[v.cur].text
    # ...and past all forty frames in one press, not forty.
    v.move_entry(1)
    assert v.source.lines[v.cur].text.endswith("INFO after"), v.source.lines[v.cur].text
    # The end says so rather than moving nowhere in silence.
    v.move_entry(1)
    assert "last entry" in v.message, v.message

    v.move_entry(-1)
    assert v.source.lines[v.cur].text.endswith("ERROR boom"), v.source.lines[v.cur].text
    v.move_entry(-1)
    v.move_entry(-1)
    assert "first entry" in v.message, v.message

    # The KEYS, not only the motion: J and K, one unit bigger than j and
    # k and reachable on any layout — where `{`/`}` are AltGr gymnastics
    # on half the keyboards in Europe.
    screen = Screen_for_test()
    screen.view = v
    v.cur = 0
    screen.step(Screenish(), ord("J"))
    assert v.source.lines[v.cur].text.endswith("ERROR boom"), v.source.lines[v.cur].text
    screen.step(Screenish(), ord("K"))
    assert v.source.lines[v.cur].text.endswith("INFO before"), v.source.lines[v.cur].text


@test
def tabbing_in_the_hit_list_brings_the_term_into_view():
    """The pager's Tab follows the pick sideways and the hit list's did
    not: a term picked past the right edge was highlighted nowhere and
    named only in the footer, so the motion had nothing to show for
    itself. A hit line is long by construction — a store, a host, a
    timestamp, then the entry."""
    uuid = "9da3dcf1-5a4b-4d36-b907-917daa60bd90"
    row = (f"{'app @ mail01':28} 12:00:01 INFO handling "
           + "padding " * 12 + f"req={uuid} done")
    screen = Screen_for_test()

    # How many Tabs reach the id is a property of the line, not something
    # to hard-code: ask by searching what each pick offers.
    taps = next(n for n in range(20)
                if screen.choose(Screenish([KEY_TAB] * n + [ord("*")]),
                                 "t", [row], searchable=True,
                                 terms_from=29) == ("term", uuid))

    # ⚠ The ROW, not the footer. The footer names the picked term too,
    # and "named in the footer while highlighted nowhere" is precisely
    # the state this is about — a check that accepts it passes before the
    # fix and proves nothing. A painted row is a suffix of the whole row,
    # because scrolling sideways is what slices it.
    def seen(scr, w):
        return [t[:w - 1] for t in scr.painted if row.endswith(t)]

    wide = Screenish([KEY_TAB] * taps + [ord("q")], width=200)
    screen.choose(wide, "t", [row], searchable=True, terms_from=29)
    assert any(uuid in t for t in seen(wide, 200)), "wide enough anyway"

    # 60 columns cannot hold the line, so the window has to move.
    narrow = Screenish([KEY_TAB] * taps + [ord("q")], width=60)
    screen.choose(narrow, "t", [row], searchable=True, terms_from=29)
    visible = seen(narrow, 60)
    assert any(uuid in t for t in visible), (
        "the picked term is off-screen:\n  " + "\n  ".join(visible))


def answer(*entries, source_id=ID_A, path="/l/app.log", version="0.26.0"):
    """A `records` stream, as timberfs writes one."""
    recs = [("stream-start", {"v": 1, "server_version": f"timberfs, {version}"},
             None),
            ("source", {"path": path, "id": source_id}, None)]
    for text, fields in entries:
        body = text.encode()
        recs.append(("entry", {"len": len(body), **fields}, body))
    return wire(*recs)


@test
def a_multi_line_entry_is_one_entry():
    """A stack trace belongs to the entry that raised it. Splitting it
    would be the same lie as splitting a line across a chunk boundary —
    and every one of its lines names the place the ENTRY came from."""
    r = tv.Records(answer(("boom\n  at A\n  at B", {"offset": 40, "ts": 1})))
    assert r.entries == 1 and len(r.lines) == 3, (r.entries, len(r.lines))
    assert [ln.text for ln in r.lines] == ["boom", "  at A", "  at B"]
    assert [ln.first for ln in r.lines] == [True, False, False]
    assert {str(r.address_of(ln)) for ln in r.lines} \
        == {f"timber:{ID_A}#offset=40"}


@test
def an_answer_is_a_closed_set():
    """Both ends are ends: nothing extends, and the boundary says "the
    answer" rather than naming a chunk that is not what you are in."""
    r = tv.Records(answer(("one", {"offset": 0})))
    assert r.at_top() and r.at_bottom()
    assert r.extend_up() is False and r.extend_down() is False
    assert "end of the answer" in r.bottom_note()
    assert "chunk" not in r.bottom_note()
    assert "1 entry matched" in r.top_notes()[0], r.top_notes()


@test
def an_entry_at_the_live_edge_is_shown_but_cannot_be_opened():
    """It is real and it matched, so it is in the answer. It is in no
    chunk yet, so there is no place to open — said, not guessed at."""
    r = tv.Records(answer(("fresh", {"ts": 9})))       # no offset
    assert r.entries == 1 and r.unplaced == 1
    assert r.address_of(r.lines[0]) is None
    assert "live edge" in r.top_notes()[0], r.top_notes()
    # It is opened by WHEN it arrived instead — the chunk it is in.
    f = Fake(["fresh\nlater\n"])
    f.chunks[0].wf, f.chunks[0].wl = 100, 200
    r.lines[0].store = f.store
    r.lines[0].wf = 150
    v = tv.View(f, source=r)
    assert v.leave_for_the_log() is True
    assert "write window" in v.message, v.message


@test
def enter_searches_on_every_pager_screen():
    """It used to mean "open the log" in an ANSWER and "search this
    term" on the tape — so picking an identifier in an answer and
    pressing Enter did something else entirely, and could fail with a
    message about opening, which was never what was asked for. Leaving
    an answer for the log is its own key."""
    f = Fake(["one\ntwo\n"])
    r = tv.Records(answer(("boom REQ3999", {"offset": 0})))
    for source, where in ((r, "an answer"), (None, "the tape")):
        v = (tv.View(f, source=source) if source is not None
             else opened(f))
        screen = Screen_for_test()
        screen.view = v
        asked = []
        screen.do_search = lambda _s, token: asked.append(token)
        v.tok = 1 if source is not None else 0
        screen.step(Screenish(), KEY_CR)
        assert asked and asked[0] == v.selected(), (where, asked)


@test
def two_streams_do_not_borrow_each_others_attribution():
    """Each host's answer names its own sources, and a one-source stream
    leaves the id off its entries. Read together without resetting, the
    second host's entries would inherit the first host's store."""
    a = answer(("from a", {"offset": 1}), source_id=ID_A, path="/l/a.log")
    b = answer(("from b", {"offset": 2}), source_id=ID_B, path="/l/b.log")
    r = tv.Records([a, b])
    assert [str(r.address_of(ln)) for ln in r.lines] == \
        [f"timber:{ID_A}#offset=1", f"timber:{ID_B}#offset=2"], \
        [str(r.address_of(ln)) for ln in r.lines]


@test
def a_target_too_old_to_place_an_entry_is_not_a_live_edge():
    """`offset` on an entry record landed in 0.26.0. A target still on
    0.25.0 answers with entries that have no place — and calling that
    "at the live edge" states a fact about the DATA where the truth is a
    fact about the server, so it sends you looking at the wrong thing.
    The stream says what produced it, which settles it."""
    old = tv.Records(answer(("boom", {"ts": 1, "wf": 150}), version="0.25.0"))
    assert old.stale == 1 and old.unplaced == 0, (old.stale, old.unplaced)
    assert "0.25.0" in old.top_notes()[0], old.top_notes()
    assert "live edge" not in old.top_notes()[0], old.top_notes()

    # And still opened, by the window the old record does carry.
    f = Fake(["boom\nnext\n"])
    f.chunks[0].wf, f.chunks[0].wl = 100, 200
    old.lines[0].store = f.store
    v = tv.View(f, source=old)
    assert v.leave_for_the_log() is True, v.message
    assert "write window" in v.message and "0.25.0" in v.message, v.message

    # A current target with an unflushed entry is still the live edge.
    fresh = tv.Records(answer(("boom", {"ts": 1, "wf": 150}), version="0.26.0"))
    assert fresh.unplaced == 1 and fresh.stale == 0
    assert "live edge" in fresh.top_notes()[0], fresh.top_notes()


@test
def a_hit_that_cannot_be_placed_is_still_a_hit():
    """It used to be DROPPED, so a term matching only on a target that
    cannot place one read as "no hit" — false, and the one thing an
    answer must never say. A couple of old servers in a fleet must not
    make a term unusable: the hits are listed, read and searched from;
    only OPENING one is refused, and then with the reason."""
    def host_answers(host):
        body = f"boom on {host}".encode()
        version = "0.25.0" if host == "old01" else "0.26.0"
        fields = {"len": len(body), "ts": 1, "wf": 7}
        if version == "0.26.0":
            fields.update(chunk=4, offset=99)
        return wire(("stream-start", {"server_version": f"timberfs, {version}"},
                     None),
                    ("source", {"path": f"/l/{host}.log", "id": ID_A}, None),
                    ("entry", fields, body))

    def ask(doc, host=None, raw=False):
        if (doc.get("response_format") or {}).get("kind") == "stores":
            return json.dumps({"server_version": "t", "stores": []}), "", 0
        return host_answers(host), "", 0

    b = tv.QueryBackend(ask, ["new01", "old01"])
    hits, unplaced, capped = b.search("boom")
    assert len(hits) == 2, [h.text for h in hits]
    assert [h.address.kind for h in hits] == ["offset", None], hits
    assert b.stale == {"old01": (0, 25, 0)}, b.stale
    assert unplaced == 0, unplaced          # old, not unflushed
    # The one that could not be placed still carries WHEN it arrived,
    # which is what opens it.
    assert hits[1].wf == 7, hits[1].wf

    v = tv.View(b, source=tv.Records(answer(("x", {"offset": 0}))))
    v.search("boom")
    assert "2 hit(s)" in v.message, v.message
    assert "old01 on 0.25.0" in v.message, v.message

    # The list says which is exact and which is by the write window.
    rows = [Screen_for_test().hit_row(h) for h in hits]
    assert rows[0].startswith(" ") and rows[1].startswith("·"), rows


@test
def a_hit_with_no_offset_is_opened_by_its_write_window():
    """An entry record has carried `wf` since long before `offset`, and
    a write-axis window of one millisecond is a seek to the chunk that
    covers it — measured against a live store, `wf` alone lands on the
    entry's own chunk. So "cannot be opened" was a limitation of the
    viewer, not a fact about the answer: what is lost is the exact line,
    and that is found in the chunk that comes back."""
    f = Fake(["alpha\nbravo\ncharlie\n"])
    f.chunks[0].wf, f.chunks[0].wl = 500, 600
    hit = tv.Hit(tv.Address(ID_A, None), f.store, "bravo", wf=550)
    v = opened(f)
    assert v.jump(hit) is True
    assert v.line().text == "bravo", v.line().text
    assert "write window" in v.message and "exact offset" in v.message, v.message

    # With neither a place nor a time there is nothing to open it by,
    # and that is said rather than guessed at.
    assert v.jump(tv.Hit(tv.Address(ID_A, None), f.store, "x")) is False
    assert "neither where nor when" in v.message, v.message


@test
def tabbing_brings_the_term_into_view():
    """A log line is 200 characters and a screen is 80, so Tab walks
    straight off the edge unless the sideways scroll follows the pick.
    Only on a PICK: scrolling by hand and having the screen snap back
    would be the same fight from the other side."""
    far = "x" * 150
    f = Fake([f"alpha {far} omega9\n"])
    v = opened(f, seq=0)
    v.cur = 0
    assert v.col == 0

    # Tab to the term at the far right; the window follows it.
    while v.selected() != "omega9":
        v.pick(1)
    v.layout(80, 10)
    span = v.selected_span()
    assert v.col <= span[0] and span[1] <= v.col + 80, (v.col, span)
    # And not flush against the edge it just came from: a term with no
    # context beside it reads as the end of the line.
    assert span[1] < v.col + 80, (v.col, span)

    # And back to the first, which is off to the LEFT from there.
    while v.selected() != "alpha":
        v.pick(1)
    v.layout(80, 10)
    span = v.selected_span()
    assert v.col <= span[0] and span[1] <= v.col + 80, (v.col, span)

    # Scrolling by hand is not undone by the next redraw.
    v.scroll_h(40)
    where = v.col
    v.layout(80, 10)
    assert v.col == where, (v.col, where)

    # Wrapped, there is no sideways scroll to follow.
    v.toggle_wrap()
    v.pick(1)
    v.layout(80, 10)
    assert v.col == 0, v.col


def main():
    want = sys.argv[1] if len(sys.argv) > 1 else ""
    chosen = [t for t in TESTS if want in t.__name__]
    failed = 0
    for t in chosen:
        try:
            t()
            print(f"  ok    {t.__name__}")
        except AssertionError as e:
            failed += 1
            print(f"  FAIL  {t.__name__}\n        {e}")
        except Exception as e:
            failed += 1
            print(f"  ERROR {t.__name__}\n        {type(e).__name__}: {e}")
    print(f"\n{len(chosen) - failed}/{len(chosen)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
