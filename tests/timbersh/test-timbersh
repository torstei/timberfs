def store(name, sid, **labels):
    return {"name": name, "id": sid, "labels": labels, "path": f"/l/{name}.log",
            "chunks": 1, "compressed_bytes": 57, "logical_bytes": 100,
            "first_seq": 0, "last_seq": 0, "dropped_chunks": 0,
            "dropped_bytes": 0, "dropped_uncompressed_bytes": 0,
            "next_seq": 1, "index_declared": False, "wal_declared": False,
            "kind": "pair", "handle": name, "dir": "/l", "followers": [],
            "retain_unconsumed": False, "rings_bytes": 100}


@test
def an_incoherent_axis_never_reaches_a_host():
    """`written since` cannot answer with loglines, and nine hosts each
    relaying that verdict is not a better error than one. It also cost
    nine round trips to learn what the shell already knew."""
    s = Session({h: {"stores": []} for h in ("a", "b", "c")},
                hosts=["a", "b", "c"]).run(
        "select loglines from [svc=web] where written since '2026-08-18';")
    assert "cannot answer with loglines" in s.out, s.out
    assert "logline since" in s.out, s.out
    # The whole point: nothing was sent.
    assert s.docs("loglines") == [], s.requests
    s.cleanup()


@test
def a_logline_window_on_chunks_is_refused_before_the_axis_is_rewritten():
    """`build` sets the axis to `write` for chunks, so a check that ran
    after the defaults let this through with the timestamp silently
    applied to the other clock."""
    s = Session({"": {"stores": []}}).run(
        "select chunks from [svc=web] where logline since '00:00';")
    assert "logline window has nothing to apply to" in s.out, s.out
    assert s.docs("chunks") == [], s.requests
    s.cleanup()


@test
def a_short_id_is_expanded_before_the_document_leaves():
    """`\\d` prints 8 of 36 characters and `id=` is exact, so the obvious
    next move selected nothing. It is resolved here; the wire gets the
    whole id."""
    s = Session({"": {"stores": [store("a1", ID_A), store("b1", ID_B)]}}).run(
        "select stores from [id=aaaaaaaa];")
    terms = [d["stores"]["select"] for d in s.docs("stores") if d["stores"].get("select")]
    assert terms and terms[-1][0]["value"] == ID_A, terms
    assert terms[-1][0]["op"] == "=", terms
    s.cleanup()


