@test
def a_fleet_can_be_reached_several_different_ways_at_once():
    """The defect this replaced: one command with `_TIMBERHOST_` in it
    made the transport a property of the SESSION, so an ssh-shaped host
    and a wrapper taking the host as an argument could not be in one
    fleet. Each target carries its own argv, and both are asked."""
    hosts = ["alpha", "beta"]
    s = Session({h: {"stores": [store(f"{h}1", ID_A if h == "alpha" else ID_B)]}
                 for h in hosts}, hosts=hosts, resolver=True)
    s.run("\\d")
    assert "alpha1" in s.out and "beta1" in s.out, s.out
    assert {r["host"] for r in s.requests} == {"alpha", "beta"}, s.requests
    s.cleanup()


