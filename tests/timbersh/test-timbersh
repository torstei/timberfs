    assert c.options("drop ", "") == ["logview", "host", "session"]
    assert "session" in c.options("show ", "")

    # The ends a session takes, and only the one still owed.
    assert c.options("create session ", "") == ["from", "to"]
    assert c.options("create session from '13:00' ", "") == ["to"]
    # ...and never the predicate a logview owes.
    assert c.options("create session ", "") != ["["]
    assert c.options("create logview x ", "") == ["["]


@test
def every_verb_the_parser_takes_is_in_the_grammar_table():
    """The bug this table exists to stop, caught mechanically rather than
    by typing: a statement added to `do()` and not to FORMS completes to
    nothing, and one in FORMS that the parser does not take is offered
    and then refused.

    Read off the source, so it cannot be kept up to date by hand either."""
    import re
    src = open(TIMBERSH).read()
    dispatched = set(re.findall(r'head == "([a-z]+)"', src))
    dispatched |= set(re.findall(r'head in \("([a-z]+)", "([a-z]+)"\)', src)[0]
                      if re.findall(r'head in \("([a-z]+)", "([a-z]+)"\)', src)
                      else [])
    forms = {f.split()[0] for f in
             re.search(r'FORMS = """(.*?)"""', src, re.S).group(1).split("\n")
             if f.strip()}
    # `select` and `tail` are dispatched together, and `help`/`save`/`load`
    # by name — every one of them has to be offerable.
    dispatched |= {"select", "tail"}
    missing = dispatched - forms
    assert not missing, f"in the parser, not in FORMS (so uncompletable): {missing}"
    extra = forms - dispatched
    assert not extra, f"in FORMS, not in the parser (offered then refused): {extra}"


@test
def the_completer_still_knows_the_rest_of_the_grammar():
    """The half a change to it could quietly break. Every point where
    exactly one kind of thing can come next, checked once."""
    c = completer(views=("console",), cursors=("errs",), hosts=("web01",))
    # The SET of verbs, not their order: the order is now FORMS' order,
    # and pinning it would make reordering the table a test failure for
    # no reason. `exit` is offered because the parser takes it.
    assert set(c.options("", "")) == set(VERBS_THE_PARSER_TAKES)
    # KINDS is the tuple the parser validates against — one list of the
    # kinds, not a second copy for the completer to drift from.
    assert list(c.options("select ", "")) == ["records", "loglines", "stores",
                                              "chunks"]
    assert c.options("select records ", "") == ["from"]
    assert "console" in c.options("select records from ", "")
    # `into view` too, which the hand-written completer never offered —
    # it is a clause the parser has taken for as long as the pager has.
    assert c.options("select records from [] ", "") == ["where", "limit", "into"]
    assert c.options("select records from [] into ", "") == ["view"]
    assert c.options("select records from [] limit ", "") == [], "a number comes next"
    # A tail does not end, so it has no answer to put in a view.
    assert c.options("tail records from [] ", "") == ["where", "limit"]
    assert c.options("select records from [] where ", "") \
        == ["entry", "chunk", "logline", "written"]
    assert c.options("select records from [] where entry ", "") \
        == ["has", "not", "substring", "regex"]
    assert c.options("select records from [] where logline ", "") \
        == ["since", "until", "between"]
    assert c.options("close ", "") == ["errs"]
    assert c.options("drop host ", "") == ["web01"]
    # A predicate literal completes its own keys, then that key's values.
    assert c.options("select records from [", "[") == ["[host=", "[type="]
    assert c.options("select records from [host=", "[host=") == ["[host=web01"]


def tape(name, sid, n=9):
    """A store with several chunks, and the chunks themselves — what a
    pager needs and a one-chunk fixture cannot exercise.

    `start` is the running total, because it IS the offset on the tape:
    a fixture where the two disagree would let a viewer that computed
    offsets from the wrong end still pass."""
    chunks, at = [], 0
    for i in range(n):
        text = f"chunk {i} first line\nc{i}\n"
        chunks.append({"seq": i, "start": at, "text": text,
                       "wf": 0, "wl": 9_999_999_999_999})
        at += len(text)
    st = store(name, sid)
    st.update(chunks=n, first_seq=0, last_seq=n - 1, logical_bytes=at,
              dropped_chunks=0, dropped_uncompressed_bytes=0)
    return st, chunks


@test
def view_seeks_to_a_chunk_and_asks_for_exactly_one():
    """`view [] at chunk 7` is a SEEK: a chunk number, one chunk, and no
    predicate at all. A `match` member here would make the pager a
    search, which is the other motion entirely."""
    st, chunks = tape("app", ID_A)
    s = Pty({"": {"stores": [st], "chunks": chunks}}).start()
    s.expect("timberfs=#")
    s.send("view [] at chunk 7;\n").expect("q quit")
    s.send("q").expect("timber:")
    s.finish()
    docs = s.docs("chunks")
    assert docs, [r["doc"] for r in s.requests]
    assert any(d["window"].get("from_chunk") == 7 for d in docs), docs
    for d in docs:
        assert d["window"]["axis"] == "write", d
        assert d["max"] == {"chunks": 1}, d
        assert "match" not in d, d
    # The address is chunk 7's own start: landing at the top of a chunk
    # reaches for the one before it, so the line held back as a possible
    # fragment is resolved rather than skipped over.
    at = sum(len(c["text"]) for c in chunks[:7])
    assert f"timber:{ID_A}#offset={at}" in s.plain, s.plain[-400:]
    s.cleanup()


