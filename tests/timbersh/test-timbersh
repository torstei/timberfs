@test
def a_probe_that_did_not_answer_is_not_an_empty_predicate():
    """The third case, and the one that misreads a WORKING selector: the
    read answered with nothing, and the probe behind "was anything
    searched" then failed. Only the hosts that answered were counted, so
    0 answers became 0 stores and a fleet that refused was reported as a
    predicate matching nothing on all of them."""
