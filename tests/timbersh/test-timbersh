@test
def a_limit_is_a_total_across_hosts():
    recs = lambda n, sid: [{"id": sid, "text": f"line {i}"} for i in range(n)]
    s = Session({"a": {"stores": [store("a1", ID_A)], "records": recs(3, ID_A)},
                 "b": {"stores": [store("b1", ID_B)], "records": recs(3, ID_B)}},
                hosts=["a", "b"]).run("select records from [svc=web] limit 4;")
    shown = sum(1 for l in s.out.splitlines() if "line " in l)
    assert shown == 4, (shown, s.out)
    s.cleanup()


@test
def an_unbounded_read_is_walked_a_page_at_a_time():
    """Nothing streams: a call is one `subprocess.run`, so an unbounded
    read held the WHOLE answer in memory, times the hosts asked in
    parallel. Measured at 3.4x the answer on the terminal path, and a
    1.1 GiB store on thirteen hosts is not a query. Every call now
    carries a page bound, and the positions come back as the next
    page's cursor."""
    recs = lambda a, b: [{"id": ID_A, "text": f"line {i}"} for i in range(a, b)]
    s = Session({"": {"stores": [store("app", ID_A)],
                      "sequence": [
                          {"records": recs(0, 3), "status": "limited",
                           "positions": [{"id": ID_A, "offset": 300}]},
                          {"records": recs(3, 5), "status": "exhausted",
                           "positions": [{"id": ID_A, "offset": 500}]}]}},
                extra=["--page", "3"]).run("select records from [];")
    assert len([l for l in s.out.splitlines() if "line " in l]) == 5, s.out
    docs = s.docs("records")
    assert len(docs) == 2, docs
    assert docs[0]["max"] == {"entries": 3}, docs[0]
    assert "cursor" not in docs[0], docs[0]
    assert docs[1]["cursor"] == [{"id": ID_A, "offset": 300}], docs[1]
    # OUR bound stopped page one, not a truncation of the answer.
    assert "STOPPED" not in s.out, s.out
    assert "5 entries, in 2 pages of 3" in s.out, s.out
    s.cleanup()


@test
def a_store_that_went_quiet_on_a_page_keeps_its_place_in_the_cursor():
    """A store that delivered nothing reports the position it was
    RESUMED from, and one never consumed reports none at all. Both must
    ride along: an offsetless entry means the start of the window, and
    dropping it re-reads that store from the beginning on every page."""
    s = Session({"": {"stores": [store("app", ID_A), store("quiet", ID_B)],
                      "sequence": [
                          {"records": [{"id": ID_A, "text": "line 0"}],
                           "status": "limited",
                           "positions": [{"id": ID_A, "offset": 300},
                                         {"id": ID_B}]},
                          {"records": [], "status": "exhausted"}]}},
                extra=["--page", "1"]).run("select records from [];")
    sent = s.docs("records")[1]["cursor"]
    assert {"id": ID_A, "offset": 300} in sent, sent
    assert {"id": ID_B} in sent, sent
    s.cleanup()


@test
def a_limit_is_one_call_because_a_page_would_resume_past_the_dropped():
    """A `limit` is a total across hosts, enforced in the client, so a
    later host is asked for the whole bound and its entries are read and
    then dropped. Its `position` records cover what it DELIVERED — so a
    cursor built from that page resumes past exactly the entries nobody
    saw. A bounded read is therefore one call, never paged."""
    recs = lambda sid: [{"id": sid, "text": f"line {i}"} for i in range(3)]
    s = Session({h: {"stores": [store(f"{h}1", ID_A if h == "a" else ID_B)],
                     "records": recs(ID_A if h == "a" else ID_B),
                     "status": "limited",
                     "positions": [{"id": ID_A if h == "a" else ID_B,
                                    "offset": 300}]}
                 for h in ("a", "b")},
                hosts=["a", "b"], extra=["--page", "2"]).run(
        "select records from [] limit 4;")
    docs = s.docs("records")
    assert len(docs) == 2, docs            # one per host, one round
    assert all(d["max"] == {"entries": 4} for d in docs), docs
    assert all("cursor" not in d for d in docs), docs
    assert len([l for l in s.out.splitlines() if "line " in l]) == 4, s.out
    s.cleanup()


@test
def a_quiet_store_keeps_its_place_across_pages():
    """A position with no offset means the START OF THE WINDOW, so handing
    the answer back verbatim re-read every store that had gone quiet.

    It takes THREE pages and a server that changes its mind: A must have a
    position, then report none while B still moves. A fake that says the
    same thing every time cannot produce that, and a test built on one
    passes with the merge removed."""
    s = Session({"": {
        "stores": [store("a1", ID_A), store("b1", ID_B)],
        "status": "limited",
        "sequence": [
            {"records": [{"id": ID_A, "text": "a-one"}],
             "positions": [{"id": ID_A, "offset": 100}, {"id": ID_B}]},
            # A delivered nothing this page: its position carries NO offset.
            {"records": [{"id": ID_B, "text": "b-one"}],
             "positions": [{"id": ID_A}, {"id": ID_B, "offset": 200}]},
            {"records": [], "positions": [{"id": ID_A}, {"id": ID_B}]},
        ]}}).run(
        "declare c cursor for select records from [svc=web];",
        "fetch 1 from c;", "fetch 1 from c;", "fetch 1 from c;")
    cursors = [d.get("cursor") for d in s.docs("records") if d.get("cursor")]
    assert len(cursors) >= 2, s.requests
    third = {c["id"]: c for c in cursors[-1]}
    # A went quiet on page two. Its place must survive that.
    assert third.get(ID_A, {}).get("offset") == 100, cursors[-1]
    assert third.get(ID_B, {}).get("offset") == 200, cursors[-1]
    s.cleanup()


@test
def hosts_can_be_added_and_dropped_at_runtime():
    s = Session({"a": {"stores": [store("a1", ID_A)]},
                 "b": {"stores": [store("b1", ID_B)]}}, hosts=["a"]).run(
        "add host b;", "\\d", "drop host a;", "show hosts;",
        "drop host nosuch;", "add host b;", "drop host b;")
    assert "2 host(s): a, b" in s.out, s.out
    assert "b1" in s.out and "a1" in s.out, s.out
    assert "1 host(s): b" in s.out, s.out
    assert "no host `nosuch`" in s.out, s.out
    assert "already there" in s.out, s.out
    assert "that is the last host" in s.out, s.out
    s.cleanup()


@test
def a_host_set_and_a_command_must_agree_both_ways():
    """Several hosts with nowhere to put them reads one forest N times.
    A placeholder with no host runs it literally — which printed "no
    stores" and read as an empty forest."""
    d = tempfile.mkdtemp(prefix="timbersh-test-")
    json.dump({}, open(os.path.join(d, "scenario.json"), "w"))
    env = {**os.environ, "FAKE_DIR": d}
    many = subprocess.run([sys.executable, TIMBERSH, "-q", "--hosts", "a,b",
                           "--cmd", FAKE], input="\\q\n", capture_output=True,
                          text=True, env=env)
    assert many.returncode != 0 and "no _TIMBERHOST_" in many.stderr, many.stderr
    none = subprocess.run([sys.executable, TIMBERSH, "-q",
                           "--cmd", f"{FAKE} _TIMBERHOST_"], input="\\q\n",
                          capture_output=True, text=True, env=env)
    assert none.returncode != 0 and "no host to put in it" in none.stderr, none.stderr
    shutil.rmtree(d, ignore_errors=True)


