#!/usr/bin/env python3
"""timbersh's tests. No VM, no timberfs, no network.

`--cmd` is injectable and `--rc` runs statements, so a whole session is a
subprocess with a scripted server on the other end. Every case here is a
bug that actually happened.

    tests/timbersh/test-timbersh          # all
    tests/timbersh/test-timbersh short_id # one, by substring
"""
import fcntl, http.server, json, os, pty, re, select, shutil, socketserver
import struct, subprocess, sys, tempfile, termios, threading, time

HERE = os.path.dirname(os.path.abspath(__file__))
TIMBERSH = os.path.join(HERE, "..", "..", "tools", "timbersh")
FAKE = os.path.join(HERE, "fake-timberfs")

sys.path.insert(0, os.path.join(HERE, "..", "..", "tools"))
from timberview import when                                  # noqa: E402

VERBS_THE_PARSER_TAKES = ["select", "tail", "view", "declare", "fetch",
                          "close", "create", "drop", "refresh", "add", "show",
                          "save", "load", "help", "quit", "exit"]

ID_A = "aaaaaaaa-1111-2222-3333-444444444444"
ID_B = "bbbbbbbb-1111-2222-3333-444444444444"


class Session:
    """One timbersh run against a scripted server."""

    def __init__(self, scenario, hosts=None, extra=(), resolver=False):
        self.dir = tempfile.mkdtemp(prefix="timbersh-test-")
        json.dump(scenario, open(os.path.join(self.dir, "scenario.json"), "w"))
        self.hosts = hosts
        self.extra = list(extra)
        self.resolver = self.write_resolver(hosts) if resolver else None
        self.targets = None
        self.servers = []

    def over_http(self, status=None):
        """Serve the same fake over a unix socket per host and reach it
        by `url`, so a whole session runs on the url transport rather
        than on an assertion about how one would be built.

        `status` scripts a non-2xx from every host: a url target has no
        stderr, so that IS how a failure arrives."""
        targets = []
        for h in self.hosts or [""]:
            sock = os.path.join(self.dir, f"{h or 'local'}.sock")
            self.servers.append(serve_fake(sock, h, self.dir, status))
            targets.append({
                "url": f"unix+http://{h or 'local'}.timberfs{sock}//query",
                **({"name": h} if h else {})})
        self.targets = os.path.join(self.dir, "targets.json")
        json.dump({"v": "1.0-EXPERIMENTAL", "targets": targets},
                  open(self.targets, "w"))
        return self

    def write_resolver(self, hosts):
        """A resolver is a program that prints the fleet. Each target
        gets its OWN argv here, which is the shape a placeholder could
        not express."""
        doc = {"v": "1.0-EXPERIMENTAL",
               "targets": [{"name": h, "cmd": [FAKE, h]} for h in hosts]}
        path = os.path.join(self.dir, "resolver")
        open(path, "w").write(
            "#!/bin/sh\ncat <<'EOF'\n" + json.dumps(doc)
            + "\nEOF\n")
        os.chmod(path, 0o755)
        return path

    def where(self):
        if self.targets:
            return ["--targets", self.targets]
        if self.resolver:
            return ["--resolver", self.resolver]
        return ["--cmd", f"{FAKE} _TIMBERHOST_" if self.hosts else FAKE] + (
            ["--hosts", ",".join(self.hosts)] if self.hosts else [])

    def run(self, *statements):
        cmd = [sys.executable, TIMBERSH, "-q",
               "--histfile", os.path.join(self.dir, "history"),
               "--rc", os.path.join(self.dir, "nonexistent-rc")]
        cmd += self.where() + self.extra
        p = subprocess.run(cmd, input="\n".join(statements) + "\n\\q\n",
                           capture_output=True, text=True,
                           env={**os.environ, "FAKE_DIR": self.dir})
        self.out, self.err, self.code = p.stdout, p.stderr, p.returncode
        return self

    @property
    def requests(self):
        path = os.path.join(self.dir, "requests.jsonl")
        if not os.path.exists(path):
            return []
        return [json.loads(l) for l in open(path) if l.strip()]

    def docs(self, kind=None):
        return [r["doc"] for r in self.requests
                if kind is None
                or (r["doc"].get("response_format") or {}).get("kind") == kind]

    def cleanup(self):
        for srv in self.servers:
            srv.shutdown()
            srv.server_close()
        shutil.rmtree(self.dir, ignore_errors=True)


def serve_fake(sock, host, fake_dir, status=None):
    """One unix-socket HTTP server in front of `fake-timberfs`: the POST
    body is the document on its stdin, its stdout is the response."""
    class H(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
            p = subprocess.run([FAKE, host] if host else [FAKE], input=body,
                               capture_output=True,
                               env={**os.environ, "FAKE_DIR": fake_dir})
            out = p.stderr if status else p.stdout
            self.send_response(status or 200)
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)

    class S(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

        def get_request(self):
            s, _ = socketserver.UnixStreamServer.get_request(self)
            return s, ("unix", 0)

    srv = S(sock, H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


class Pty(Session):
    """A session on a terminal, for the statements that open a screen.

    `view` refuses a pipe, and a viewer driven by sleeps would be a test
    that sometimes passes — so this waits for what the screen actually
    printed before sending the next key."""

    def start(self, rows=24, cols=110):
        cmd = [sys.executable, TIMBERSH, "-q",
               "--histfile", os.path.join(self.dir, "history"),
               "--rc", os.path.join(self.dir, "nonexistent-rc")]
        cmd += self.where() + self.extra
        env = {**os.environ, "FAKE_DIR": self.dir, "TERM": "xterm"}
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.execve(cmd[0], cmd, env)
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ,
                    struct.pack("HHHH", rows, cols, 0, 0))
        self.seen = ""
        return self

    @property
    def plain(self):
        """What the screen SAYS. curses splits a line into styled runs
        wherever a term is highlighted, so the text of a rendered line
        is never contiguous in the raw stream."""
        return re.sub(r"\x1b[\[(][0-9;?]*[A-Za-z]", "", self.seen)

    def expect(self, marker, timeout=20):
        end = time.time() + timeout
        while marker not in self.plain:
            if time.time() > end:
                raise AssertionError(
                    f"waited {timeout}s for {marker!r}; saw:\n{self.plain[-800:]}")
            r, _, _ = select.select([self.fd], [], [], 0.2)
            if r:
                try:
                    self.seen += os.read(self.fd, 65536).decode(
                        "utf-8", "replace")
                except OSError:
                    break
        return self

    def send(self, text):
        os.write(self.fd, text.encode())
        return self

    def finish(self):
        self.send("\\q\n")
        end = time.time() + 10
        while time.time() < end:
            r, _, _ = select.select([self.fd], [], [], 0.2)
            if not r:
                continue
            try:
                self.seen += os.read(self.fd, 65536).decode("utf-8", "replace")
            except OSError:
                break
        try:
            os.close(self.fd)
        except OSError:
            pass
        os.waitpid(self.pid, 0)
        return self


