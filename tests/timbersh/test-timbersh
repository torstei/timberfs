    w = s.docs("chunks")[0]["window"]
    assert w["axis"] == "write", w
    # The statement's own start is inside the session, so it stands; the
    # far end is the session's, widened by a minute.
    assert w["from"] == 1788091800000, w
    assert w["to"] == 1788094800000 + 60_000, w
    s.cleanup()


def completer(views=("console",), cursors=(), hosts=()):
    """The completer, with a shell that has some of everything. It is
    pure logic over the line typed, so it needs no terminal and no host —
    which is why there is no excuse for the gap this closes."""
    import importlib.machinery, importlib.util
    ld = importlib.machinery.SourceFileLoader("tsh", TIMBERSH)
    sp = importlib.util.spec_from_loader("tsh", ld)
    m = importlib.util.module_from_spec(sp)
    sys.modules["tsh"] = m
    ld.exec_module(m)
    m.TARGETS = list(hosts) or [None]

    class Sh:
        def __init__(self):
            self.views = {v: [] for v in views}
            self.cursors = {c: {} for c in cursors}

        def universe(self, fresh=False):
            return [{"name": "app"}]

        def keys_of(self):
            return {"host", "type"}

        def values_of(self, key):
            return {"web01"} if key == "host" else {"console"}

    return m.Complete(Sh())


