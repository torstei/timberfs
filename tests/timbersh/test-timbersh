def store(name, sid, **labels):
    return {"name": name, "id": sid, "labels": labels, "path": f"/l/{name}.log",
            "chunks": 1, "compressed_bytes": 57, "logical_bytes": 100,
            "first_seq": 0, "last_seq": 0, "dropped_chunks": 0,
            "dropped_bytes": 0, "dropped_uncompressed_bytes": 0,
            "next_seq": 1, "index_declared": False, "wal_declared": False,
            "kind": "pair", "handle": name, "dir": "/l", "followers": [],
            "retain_unconsumed": False, "rings_bytes": 100}



@test
def a_tail_keeps_up_with_a_store_stamped_ahead_of_the_clock():
    """A tail printed one burst and then went silent while the store kept
    filling — reported against a production store read in the wrong zone,
    where every entry is stamped two hours ahead.

    The poll advanced its window to the last entry's own timestamp, and
    no chunk is written in the future, so every store on every host went
    quiet together. It resumes from a position now."""
    now = int(time.time() * 1000)
    ahead = now + 2 * 3600 * 1000

    def entry(i):
        return {"id": ID_A, "text": f"line {i}", "offset": i * 100,
                "wf": now + i * 1000, "ts": ahead + i * 1000}

    s = Pty({"": {"stores": [store("app", ID_A)],
                  "sequence": [{"records": [entry(1)]},
                               {"records": [entry(1), entry(2)]},
                               {"records": [entry(1), entry(2), entry(3)]}]}}
            ).start()
    s.expect("timberfs=#")
    s.send("tail records from [];\n")
    s.expect("line 3")
    s.send("\x03")
    s.expect("stopped")
    s.finish()
    docs = s.docs("records")
    assert len(docs) >= 3, docs
    assert all("cursor" in d for d in docs[1:]), \
        f"a poll that carried no position: {docs}"
    assert len({d["window"]["from"] for d in docs}) == 1, \
        f"the window followed the entries' clock: {[d['window'] for d in docs]}"
    assert s.plain.count("line 1") == 1, \
        f"an entry came back twice:\n{s.plain[-800:]}"
    s.cleanup()


@test
def a_store_stamped_ahead_cannot_starve_the_ones_beside_it():
    """The tail asked every host the SAME document and advanced its window
    from whichever answered — so one store's clock chose where every other
    store was read from next, and the skewed host silenced its neighbour
    as thoroughly as itself.

    A position is per store, so each now resumes from its own."""
    now = int(time.time() * 1000)

    def entries(sid, skew, upto):
        return [{"id": sid, "text": f"{sid[:1]} line {i}", "offset": i * 100,
                 "wf": now + i * 1000, "ts": now + skew + i * 1000}
                for i in range(1, upto + 1)]

    def host(name, sid, skew):
        return {"stores": [store(name, sid)],
                "sequence": [{"records": entries(sid, skew, n)}
                             for n in (1, 2, 3)]}

    s = Pty({"ontime": host("ontime", ID_A, 0),
             "ahead": host("ahead", ID_B, 2 * 3600 * 1000)},
            hosts=["ontime", "ahead"]).start()
    s.expect("timberfs=#")
    s.send("tail records from [];\n")
    # Both, and in neither order: each store is waited for on its own,
    # which is the isolation being asserted.
    s.expect("a line 3").expect("b line 3")
    s.send("\x03")
    s.expect("stopped")
    s.finish()
    s.cleanup()

@test
def an_incoherent_axis_never_reaches_a_host():
    """`written since` cannot answer with loglines, and nine hosts each
    relaying that verdict is not a better error than one. It also cost
    nine round trips to learn what the shell already knew."""
    s = Session({h: {"stores": []} for h in ("a", "b", "c")},
                hosts=["a", "b", "c"]).run(
        "select loglines from [svc=web] where written since '2026-08-18';")
    assert "cannot answer with loglines" in s.out, s.out
    assert "logline since" in s.out, s.out
    # The whole point: nothing was sent.
    assert s.docs("loglines") == [], s.requests
    s.cleanup()


@test
def a_logline_window_on_chunks_is_refused_before_the_axis_is_rewritten():
    """`build` sets the axis to `write` for chunks, so a check that ran
    after the defaults let this through with the timestamp silently
    applied to the other clock."""
