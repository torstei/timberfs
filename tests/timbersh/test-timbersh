@test
def a_quiet_store_keeps_its_place_across_pages():
    """A position with no offset means the START OF THE WINDOW, so handing
    the answer back verbatim re-read every store that had gone quiet.

    It takes THREE pages and a server that changes its mind: A must have a
    position, then report none while B still moves. A fake that says the
    same thing every time cannot produce that, and a test built on one
    passes with the merge removed."""
    s = Session({"": {
        "stores": [store("a1", ID_A), store("b1", ID_B)],
        "status": "limited",
        "sequence": [
            {"records": [{"id": ID_A, "text": "a-one"}],
             "positions": [{"id": ID_A, "offset": 100}, {"id": ID_B}]},
            # A delivered nothing this page: its position carries NO offset.
            {"records": [{"id": ID_B, "text": "b-one"}],
             "positions": [{"id": ID_A}, {"id": ID_B, "offset": 200}]},
            {"records": [], "positions": [{"id": ID_A}, {"id": ID_B}]},
        ]}}).run(
        "declare c cursor for select records from [svc=web];",
        "fetch 1 from c;", "fetch 1 from c;", "fetch 1 from c;")
    cursors = [d.get("cursor") for d in s.docs("records") if d.get("cursor")]
    assert len(cursors) >= 2, s.requests
    third = {c["id"]: c for c in cursors[-1]}
    # A went quiet on page two. Its place must survive that.
    assert third.get(ID_A, {}).get("offset") == 100, cursors[-1]
    assert third.get(ID_B, {}).get("offset") == 200, cursors[-1]
    s.cleanup()


@test
def hosts_can_be_added_and_dropped_at_runtime():
    s = Session({"a": {"stores": [store("a1", ID_A)]},
                 "b": {"stores": [store("b1", ID_B)]}}, hosts=["a"]).run(
        "add host b;", "\\d", "drop host a;", "show hosts;",
        "drop host nosuch;", "add host b;", "drop host b;")
    assert "2 host(s): a, b" in s.out, s.out
    assert "b1" in s.out and "a1" in s.out, s.out
    assert "1 host(s): b" in s.out, s.out
    assert "no host `nosuch`" in s.out, s.out
    assert "already there" in s.out, s.out
    assert "that is the last host" in s.out, s.out
    s.cleanup()


