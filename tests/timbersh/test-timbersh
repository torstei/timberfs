def tape(name, sid, n=9):
    """A store with several chunks, and the chunks themselves — what a
    pager needs and a one-chunk fixture cannot exercise.

    `start` is the running total, because it IS the offset on the tape:
    a fixture where the two disagree would let a viewer that computed
    offsets from the wrong end still pass."""
    chunks, at = [], 0
    for i in range(n):
        text = f"chunk {i} first line\nc{i}\n"
        chunks.append({"seq": i, "start": at, "text": text,
                       "wf": 0, "wl": 9_999_999_999_999})
        at += len(text)
    st = store(name, sid)
    st.update(chunks=n, first_seq=0, last_seq=n - 1, logical_bytes=at,
              dropped_chunks=0, dropped_uncompressed_bytes=0)
    return st, chunks


@test
def view_seeks_to_a_chunk_and_asks_for_exactly_one():
    """`view [] at chunk 7` is a SEEK: a chunk number, one chunk, and no
    predicate at all. A `match` member here would make the pager a
    search, which is the other motion entirely."""
    st, chunks = tape("app", ID_A)
    s = Pty({"": {"stores": [st], "chunks": chunks}}).start()
    s.expect("timberfs=#")
    s.send("view [] at chunk 7;\n").expect("q quit")
    s.send("q").expect("timber:")
    s.finish()
    docs = s.docs("chunks")
    assert docs, [r["doc"] for r in s.requests]
    assert any(d["window"].get("from_chunk") == 7 for d in docs), docs
    for d in docs:
        assert d["window"]["axis"] == "write", d
        assert d["max"] == {"chunks": 1}, d
        assert "match" not in d, d
    # The address is chunk 7's own start: landing at the top of a chunk
    # reaches for the one before it, so the line held back as a possible
    # fragment is resolved rather than skipped over.
    at = sum(len(c["text"]) for c in chunks[:7])
    assert f"timber:{ID_A}#offset={at}" in s.plain, s.plain[-400:]
    s.cleanup()


@test
def view_at_a_time_is_one_chunk_on_the_write_axis():
    """A position in time is the chunk COVERING that instant — a window
    whose ends are the same millisecond, on the axis a chunk has."""
    st, chunks = tape("app", ID_A)
    s = Pty({"": {"stores": [st], "chunks": chunks}}).start()
    s.expect("timberfs=#")
    s.send("view [] at '2026-08-29 12:00';\n").expect("q quit")
    s.send("q").expect("timber:")
    s.finish()
    timed = [d for d in s.docs("chunks") if "from" in d["window"]]
    assert timed, s.docs("chunks")
    d, ms = timed[0], when("2026-08-29 12:00")
    assert d["window"]["from"] == d["window"]["to"] == ms, d
    assert d["window"]["axis"] == "write" and d["max"] == {"chunks": 1}, d
    s.cleanup()


