@test
def a_resolver_that_failed_stops_the_session():
    """Falling back to a default would answer a question about one fleet
    with a different one — and an empty fleet used to mean "ask this
    machine", which reads exactly like a fleet that held nothing."""
    d = tempfile.mkdtemp(prefix="timbersh-test-")
    bad = os.path.join(d, "bad")
    open(bad, "w").write("#!/bin/sh\necho 'discovery is down' >&2\nexit 4\n")
    os.chmod(bad, 0o755)
    p = subprocess.run([sys.executable, TIMBERSH, "-q", "--resolver", bad],
                       input="\\q\n", capture_output=True, text=True)
    assert p.returncode != 0, p
    assert "exit 4" in p.stderr and "discovery is down" in p.stderr, p.stderr
    empty = os.path.join(d, "empty")
    open(empty, "w").write(
        '#!/bin/sh\necho \'{"v": "1.0-EXPERIMENTAL", "targets": []}\'\n')
    os.chmod(empty, 0o755)
    q = subprocess.run([sys.executable, TIMBERSH, "-q", "--resolver", empty],
                       input="\\q\n", capture_output=True, text=True)
    assert q.returncode != 0 and "nothing to ask" in q.stderr, q.stderr
    shutil.rmtree(d, ignore_errors=True)


@test
def one_target_being_down_does_not_stop_the_others():
    """Something in the system being down must not prevent inspecting
    the logs that ARE available. The failure is named — once, in full —
    and every other target still answers."""
    hosts = ["alpha", "beta", "gone"]
    s = Session({"alpha": {"stores": [store("a1", ID_A)],
                           "records": [{"id": ID_A, "text": "hit on alpha"}]},
                 "beta": {"stores": [store("b1", ID_B)],
                          "records": [{"id": ID_B, "text": "hit on beta"}]},
                 "gone": {"fail": "ssh: connect to host gone: No route to host",
                          "code": 255}},
                hosts=hosts, resolver=True).run(
        "\\d", "select records from [] where entry has 'hit' limit 9;")
    assert "a1" in s.out and "b1" in s.out, s.out
    assert "hit on alpha" in s.out and "hit on beta" in s.out, s.out
    assert "No route to host" in s.out, s.out
    assert "gone" in s.out, s.out
    s.cleanup()


