@test
def add_host_under_a_resolver_says_where_to_add_it():
    """`add host` needs a command to reach the new host WITH, and only
    the `--cmd` shape carries one that generalises. Inventing one would
    reach the wrong thing, or nothing, and report whatever that was."""
