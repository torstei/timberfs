@test
def select_into_view_asks_for_records_and_pages_the_answer():
    """`select` walks an answer and `view` walks the log; this puts the
    first on the second's screen, which works because an entry record
    carries the offset it came from."""
    st, chunks = tape("app", ID_A)
    s = Pty({"": {"stores": [st], "chunks": chunks,
                  "records": [{"id": ID_A, "text": "boom at 12:00"}]}}).start()
    s.expect("timberfs=#")
    s.send("select records from [] where entry has 'boom' into view;\n")
    # `o log around` is the footer only an ANSWER has; Enter searches
    # here exactly as it does on the tape.
    s.expect("o log around")
    assert "1 entry matched" in s.plain, s.plain[-400:]
    assert "boom at 12:00" in s.plain, s.plain[-400:]
    s.send("q").expect("timberfs=#")
    s.finish()
    docs = s.docs("records")
    assert docs, [r["doc"] for r in s.requests]
    assert docs[-1]["match"]["all"] == [{"has": "boom"}], docs[-1]
    s.cleanup()


def main():
    want = sys.argv[1] if len(sys.argv) > 1 else ""
    chosen = [t for t in TESTS if want in t.__name__]
    failed = 0
    for t in chosen:
        try:
            t()
            print(f"  ok    {t.__name__}")
        except AssertionError as e:
            failed += 1
            print(f"  FAIL  {t.__name__}\n        {e}")
        except Exception as e:
            failed += 1
            print(f"  ERROR {t.__name__}\n        {type(e).__name__}: {e}")
    print(f"\n{len(chosen) - failed}/{len(chosen)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
