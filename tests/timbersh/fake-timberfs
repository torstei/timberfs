#!/usr/bin/env python3
"""A timberfs that answers from a script, and records what it was asked.

The point is the RECORDING. Most of what has gone wrong in timbersh was in
the document it SENT — a window on the wrong axis, a short id that never
became a long one, a cursor handed back in a way that lost a store's
place. None of that is visible in the output, so a test that only reads
the printed answer cannot see it.

    FAKE_DIR       where to write requests.jsonl, and where the scenario is
    TIMBERSH_TEST_HOST   the host name (substituted into --cmd by timbersh)

The scenario is FAKE_DIR/scenario.json, one entry per host (or "" for the
unnamed one):

    {"alpha": {"stores": [ ... ], "loglines": "...", "records": [...]},
     "beta":  {"fail": "ssh: no route to host", "code": 255},
     "half":  {"stores": [...], "refuse": {"records": {"fail": "...", "code": 3}}},
     "slow":  {"stores": [...], "records": [...], "delay_ms": 5000},
     "old":   {"stores": [...], "bare": true}}     <- pre-envelope server

A `chunks` answer carries COMPRESSED frames, so the fake compresses too:
a viewer that decodes what this sends is a viewer that decodes what
timberfs sends.
"""
import json, os, subprocess, sys

FAKE_DIR = os.environ["FAKE_DIR"]
host = sys.argv[1] if len(sys.argv) > 1 else ""

doc = json.loads(sys.stdin.read() or "{}")
with open(os.path.join(FAKE_DIR, "requests.jsonl"), "a") as f:
    f.write(json.dumps({"host": host, "doc": doc}) + "\n")

kind = (doc.get("response_format") or {}).get("kind", "loglines")

scenario = json.load(open(os.path.join(FAKE_DIR, "scenario.json")))
me = scenario.get(host, {})

# A host may answer DIFFERENTLY on successive calls, which is the only way
# to test anything about paging: a store that had a position and then goes
# quiet is the case a cursor loses, and it cannot happen twice in a row to
# a server that always says the same thing.
#
# ⚠ Counted per KIND. timbersh reads the store list at startup and again
# whenever the host set changes, so a counter over all calls advances the
# sequence before the first `fetch` — and a paging test then begins at
# page two and quietly proves nothing.
if "sequence" in me:
    n = os.path.join(FAKE_DIR, f"calls-{host or 'local'}-{kind}")
    i = int(open(n).read()) if os.path.exists(n) else 0
    open(n, "w").write(str(i + 1))
    seq = me["sequence"]
    me = {**me, **seq[min(i, len(seq) - 1)]}

# A host may refuse ONE kind of question. A read that fails where the
# store listing beside it succeeds is what makes a fan-out that never
# answered look like a predicate that matched nothing, and a scenario
# that can only fail every call cannot produce it.
if kind in me.get("refuse", {}):
    me = {**me, **me["refuse"][kind]}

# A host that takes its time. Not a timing bet in the test that uses it:
# the sleep is explicit and long, and what is asserted is that another
# host's output arrives while this one is still asleep.
if me.get("delay_ms"):
    import time
    time.sleep(me["delay_ms"] / 1000.0)

if "fail" in me:
    print(me["fail"], file=sys.stderr)
    sys.exit(me.get("code", 1))
if "note" in me:                       # stderr on a SUCCESSFUL call
    print(me["note"], file=sys.stderr)

def zstd(data):
    try:
        from compression.zstd import compress          # stdlib from 3.14
        return compress(data)
    except ImportError:
        pass
    p = subprocess.run(["zstd", "-q", "-c"], input=data, capture_output=True)
    if p.returncode:
        sys.exit(f"fake-timberfs: no way to compress a chunk: {p.stderr!r}")
    return p.stdout


def chunk_answer(me, doc):
    """`timberfs-records(5)` framing for chunks: the header states a
    `len`, then that many bytes of frame. The payload is binary, so it
    is written to the buffer rather than printed."""
    win = doc.get("window") or {}
    chunks = me.get("chunks", [])
    want = win.get("from_chunk")
    if want is not None:
        chunks = [c for c in chunks if c["seq"] >= want]
    elif "from" in win:
        lo, hi = win["from"], win.get("to", win["from"])
        chunks = [c for c in chunks
                  if c.get("wl", 0) >= lo and c.get("wf", 0) <= hi]
    cap = (doc.get("max") or {}).get("chunks")
    if cap is not None:
        chunks = chunks[:cap]
    sid = (me.get("stores") or [{}])[0].get("id", "?")
    out = [f"\x1estream-start\x1fv=1\x1fserver_version="
           f"{me.get('version', 'timberfs, 0.25.0')}\x1forder=sequential"
           f"\x1fsources=1\0".encode()]
    out.append(f"\x1esource\x1fpath=/l/x.log\x1fid={sid}"
               f"\x1fkept={len(chunks)}\x1ftotal={len(me.get('chunks', []))}"
               f"\0".encode())
    for c in chunks:
        body = c["text"].encode()
        frame = zstd(body)
        out.append(f"\x1echunk\x1flen={len(frame)}\x1fid={sid}"
                   f"\x1fchunk={c['seq']}\x1funcomp_start={c['start']}"
                   f"\x1funcomp_len={len(body)}\x1fwf={c.get('wf', 0)}"
                   f"\x1fwl={c.get('wl', 0)}\0".encode())
        out.append(frame + b"\0")
    out.append(f"\x1estream-end\x1fchunks={len(chunks)}"
               f"\x1fchunks_total={len(me.get('chunks', []))}"
               f"\x1fstatus=exhausted\0".encode())
    sys.stdout.buffer.write(b"".join(out))
    sys.stdout.buffer.flush()


if kind == "chunks":
    chunk_answer(me, doc)
elif kind == "stores":
    stores = me.get("stores", [])
    # A server from before the envelope answers with the bare array.
    if me.get("bare"):
        print(json.dumps(stores))
    else:
        print(json.dumps({"server_version": me.get("version", "timberfs, 0.25.0"),
                          "stores": stores}))
elif kind == "records":
    out = [f"\x1estream-start\x1fv=1\x1fserver_version={me.get('version', 'timberfs, 0.25.0')}"
           f"\x1forder=sequential\x1fsources={len(me.get('stores', []))}\0"]
    for s in me.get("stores", []):
        out.append(f"\x1esource\x1fpath=/l/{s['name']}.log\x1fid={s['id']}"
                   f"\x1fkept=1\x1ftotal=1\0")
    for e in me.get("records", []):
        out.append(f"\x1eentry\x1flen={len(e['text'])}\x1fid={e['id']}\0{e['text']}\0")
    for p in me.get("positions", []):
        off = f"\x1foffset={p['offset']}" if "offset" in p else ""
        out.append(f"\x1eposition\x1fpath=/l/x.log\x1fid={p['id']}{off}"
                   f"\x1fchunks_read=1\x1fchunks_selected=1\0")
    out.append(f"\x1estream-end\x1fentries={len(me.get('records', []))}"
               f"\x1fstatus={me.get('status', 'exhausted')}\0")
    sys.stdout.write("".join(out))
else:
    sys.stdout.write(me.get("loglines", ""))
