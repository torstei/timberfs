# Systemd unit for the OTLP/HTTP logs intake (see timberfs-otlp.socket).
# Not templated — one instance serves every stream it sees, each landing in
# its own store at /var/log/timberfs/<service.name>/<service.name>.log: the
# same layout every timberfs intake writes, so a stream's store is named
# after the service and nothing about the protocol that carried it
# (`timberfs query checkout` resolves it by that name).
#
# The sender posts OTLP/HTTP to /v1/logs in either encoding (binary
# protobuf or JSON), gzipped or not, so an OpenTelemetry Collector needs
# nothing beyond the endpoint:
#
#   exporters:
#     otlphttp/timberfs:
#       endpoint: http://127.0.0.1:4318
#
# Override the store directory, routing attribute, or add retention with a
# drop-in:
#
#   systemctl edit timberfs-otlp.service
#     [Service]
#     ExecStart=
#     ExecStart=/usr/bin/timberfs otlp-intake --exit-on-upgrade \
#         --forest default --retain 30d --index
#
# This is socket-activated: enable the .socket, not this unit.

[Unit]
Description=timberfs OTLP/HTTP logs intake
Documentation=https://github.com/torstei/timberfs
Requires=timberfs-otlp.socket
After=timberfs-otlp.socket

[Service]
Type=simple
ExecStart=/usr/bin/timberfs otlp-intake --forest default --exit-on-upgrade
# NOT StandardInput=socket: this is a listen socket accepting many
# connections, handed over the standard LISTEN_FDS/LISTEN_PID protocol at
# fd 3 (SD_LISTEN_FDS_START).
StandardOutput=journal
StandardError=journal

# Owns /var/log/timberfs (0755) — the directory this receiver creates each
# stream's own store directory in. With --auto-create that means write
# permission on it, so a confined instance (a User= drop-in) is better given
# a forest of its own — a SIBLING, not a subdirectory: forests may not nest,
# because a store inside two of them has an unresolvable handle. Declare it
# with `timberfs forest create /srv/otel-logs` and point --forest at it.
# Without
# --auto-create the receiver creates nothing and needs none: the operator
# pre-creates each store, wherever that store's owner should be.
LogsDirectory=timberfs

# A restart drops in-flight connections. OTLP senders are built for that:
# an export that gets no response is retried, which is why the response is
# only sent once the batch is durable (at-least-once, not exactly-once — a
# retried export after a restart can duplicate records).
Restart=always
RestartSec=1
# --exit-on-upgrade: the daemon exits 85 when its binary is upgraded on
# disk; force a restart onto the new binary. SuccessExitStatus keeps it out
# of the failure log. (Keep --exit-on-upgrade in any ExecStart override.)
SuccessExitStatus=85
RestartForceExitStatus=85

# No [Install] section: this is socket-activated. Enable the .socket.
