# Receives the native replication wire: compressed chunks land verbatim, so
# the store here is byte-identical to its source. A stream lands in the store
# its IDENTITY names — the id travels, so a replica is the store in another
# place — and never in one a label names.
#
# --auto-create is deliberately absent: a stream never received here is
# refused and said so, as the other intakes do. Add it when senders should be
# allowed to mint stores here, which is what an archive usually wants.
#
#   systemctl edit timberfs-frames.service
#     [Service]
#     ExecStart=
#     ExecStart=/usr/bin/timberfs frames-intake --forest default \
#         --index --auto-create --exit-on-upgrade
[Unit]
Description=timberfs native replication intake
Documentation=https://github.com/torstei/timberfs
Requires=timberfs-frames.socket
After=timberfs-frames.socket

[Service]
Type=simple
ExecStart=/usr/bin/timberfs frames-intake --forest default --exit-on-upgrade
StandardOutput=journal
StandardError=journal
LogsDirectory=timberfs
Restart=always
RestartSec=1
SuccessExitStatus=85
RestartForceExitStatus=85
