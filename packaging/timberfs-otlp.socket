# Systemd socket for the OTLP/HTTP intake (see timberfs-otlp.service).
#
# One TCP listener shared by every stream a sender talks about — OTLP
# multiplexes resources inside the request body, not over separate sockets
# — so there is no per-instance template here.
#
# Listens on loopback only by default: this receiver adds no TLS and OTLP
# carries no authentication of its own (see the module doc comment in
# src/otlp_intake.rs and docs/deployment.md), so anything reachable on the
# listening address can write to any store in the forest it writes to. Override the
# address (e.g. to bind a private interface for a remote collector) with a
# drop-in:
#
#   systemctl edit timberfs-otlp.socket
#     [Socket]
#     ListenStream=
#     ListenStream=10.0.0.5:4318
#
#   systemctl enable --now timberfs-otlp.socket
#
# 4318 is the OTLP/HTTP port. There is deliberately no listener on 4317:
# that is OTLP/gRPC, which this does not speak — put an OpenTelemetry
# Collector in front if a sender needs it.

[Unit]
Description=timberfs OTLP/HTTP logs intake
Documentation=https://github.com/torstei/timberfs

[Socket]
ListenStream=127.0.0.1:4318
Accept=no

[Install]
WantedBy=sockets.target
