# Systemd template unit for shipping one store to an OTLP/HTTP receiver.
#
# Each instance reads /etc/timberfs/otlp-<instance>.conf, which must define
# STORE and ENDPOINT (and may define EXTRA_OPTS). Example:
#
#   /etc/timberfs/otlp-applogs.conf:
#     STORE=/var/log/timberfs-backing/applogs/app.log
#     ENDPOINT=http://127.0.0.1:4318
#     EXTRA_OPTS=--service checkout --resource deployment.environment=prod
#
#   systemctl enable --now timberfs-otlp@applogs
#
# One instance per store: the cursor is a position in ONE store, and a
# stalled receiver must not hold up an unrelated one.

[Unit]
Description=timberfs OTLP shipper (%i)
Documentation=https://github.com/torstei/timberfs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/timberfs/otlp-%i.conf
ExecStart=/usr/bin/timber-otlp --follow \
    --cursor /var/lib/timberfs/otlp-%i.cursor \
    --endpoint ${ENDPOINT} $EXTRA_OPTS ${STORE}

# Owns /var/lib/timberfs (0755), where the cursor lives: CONSUMER state,
# deliberately not inside the store's backing directory.
StateDirectory=timberfs

StandardOutput=journal
StandardError=journal

# A reader, so a restart cannot hurt the store: the cursor is written only
# after the receiver accepts a batch, so an interrupted send is re-delivered
# rather than skipped (at-least-once, as OTLP itself is).
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
