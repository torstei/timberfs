# Example instance configuration for timberfs-otlp@.service.
# Copy to /etc/timberfs/otlp-<instance>.conf and start with:
#   systemctl enable --now timberfs-otlp@<instance>
#
# The store to ship (its logical name, next to the .trunk/.rings pair):
STORE=/var/log/timberfs-backing/applogs/app.log
# The OTLP/HTTP receiver: a base URL (/v1/logs is appended) or the signal
# URL itself. Plaintext http only — terminate TLS in a collector beside it.
ENDPOINT=http://127.0.0.1:4318
# Extra flags for `timber-otlp`, e.g. the resource this store describes.
EXTRA_OPTS=--service applogs
