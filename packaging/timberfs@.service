# Systemd template unit for a timberfs mount.
#
# Each instance reads /etc/timberfs/<instance>.conf, which must define
# BACKING and MOUNTPOINT (and may define EXTRA_OPTS). Example:
#
#   /etc/timberfs/applogs.conf:
#     BACKING=/var/log/timberfs-backing/applogs
#     MOUNTPOINT=/var/log/apps
#     EXTRA_OPTS=--allow-other
#
#   systemctl enable --now timberfs@applogs
#
# Stopping the unit unmounts first (ExecStop), which makes the daemon flush
# all buffers and exit cleanly.

[Unit]
Description=timberfs compressed log filesystem (%i)
Documentation=https://github.com/torstei/timberfs
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/timberfs/%i.conf
# /bin, not /usr/bin, for anything that is not ours: a release without
# merged /usr has coreutils in /bin and no /usr/bin/mkdir at all, and on a
# merged one /bin is a symlink into /usr/bin, so /bin resolves everywhere.
# Exec lines take an absolute path — systemd's PATH lookup needs 239, which
# is newer than the oldest release we package for.
ExecStartPre=/bin/mkdir -p ${BACKING} ${MOUNTPOINT}
ExecStart=/usr/bin/timberfs mount ${BACKING} ${MOUNTPOINT} --exit-on-upgrade $EXTRA_OPTS
# Our own binary, so one path and no alternatives to try here: `umount`
# discovers the helper (fuse3's fusermount3, fuse 2.9's fusermount) from
# the same candidate list fuser mounts with. Fatal on purpose — a busy
# mountpoint should fail the stop rather than pass quietly.
ExecStop=/usr/bin/timberfs umount ${MOUNTPOINT}
Restart=on-failure
RestartSec=2
# --exit-on-upgrade makes the daemon exit 85 when its binary is replaced on
# disk (a package upgrade); force a restart on that so the mount comes back
# on the new binary (auto_unmount tears the old one down). SuccessExitStatus
# keeps it out of the failure log. Runs on `apt upgrade`, attended or not.
SuccessExitStatus=85
RestartForceExitStatus=85

[Install]
WantedBy=multi-user.target
